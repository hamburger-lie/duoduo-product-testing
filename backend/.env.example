APP_ENV=development
APP_NAME=duoduo-product-testing-api
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_me_for_local_development_only
APP_JWT_EXPIRE_DAYS=7
# Local Docker Compose maps PostgreSQL host port 5433 to container port 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/duoduo
# Local Docker Compose maps Redis host port 6380 to container port 6379.
REDIS_URL=redis://localhost:6380/0
LOG_LEVEL=INFO

# WeChat mini-program (leave empty to use mock login)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# === AI Provider (文本类任务) ===
AI_PROVIDER=mock          # mock | deepseek

# === DeepSeek (文本主力) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-chat
DEEPSEEK_MODEL_FLASH=deepseek-chat

# === 智谱 GLM (多模态/视觉，产品图片理解专用) ===
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_VISION=glm-4.6v

# === 火山方舟 (已废弃，保留字段但不再使用) ===
