# ============================================================
# 生产环境变量模板
# 复制为 .env.production 并填写真实值后再部署
# APP_ENV=production 时会强制校验以下必填项
# ============================================================

APP_ENV=production
APP_NAME=duoduo-product-testing-api
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# 必填：至少 32 字符的随机密钥
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

APP_JWT_EXPIRE_DAYS=7

# 必填：真实数据库连接（不能用 localhost）
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/duoduo

# 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800

# 必填：真实 Redis 地址
REDIS_URL=redis://redis-host:6379/0

LOG_LEVEL=INFO

# 必填：生产环境必须为 celery
EVALUATION_RUN_MODE=celery

# 必填：不能为 *，填写真实前端域名（逗号分隔）
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 必填：微信小程序凭证（为空会启用 mock 登录）
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret

# 积分扣费（每个人设的积分成本，默认 10）
CREDIT_COST_PER_PERSONA=10

# 必填：AI 提供商（生产环境不能为 mock）
AI_PROVIDER=deepseek

# 必填（当 AI_PROVIDER=deepseek 时）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-flash
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash

# 智谱 GLM 视觉（产品图片理解）
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_VISION=glm-4.6v
