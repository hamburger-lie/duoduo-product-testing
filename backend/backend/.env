APP_ENV=development
APP_NAME=duoduo-product-testing-api
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_me_for_local_development_only
APP_JWT_EXPIRE_DAYS=7
# Local Docker Compose maps PostgreSQL host port 5433 to container port 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/duoduo
REDIS_URL=redis://localhost:6380/0
LOG_LEVEL=INFO

# WeChat mini-program (leave empty to use mock login)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Local dev only: keep WeChat DevTools mock login on one user.
WECHAT_MOCK_OPENID=mock_openid_local_dev

# === AI Provider (文本类任务) ===
AI_PROVIDER=deepseek
# DeepSeek survey generation timeout. Timeout returns an error; it never falls back to local templates.
SURVEY_AI_TIMEOUT_SECONDS=90

# === DeepSeek (文本主力) ===
DEEPSEEK_API_KEY=sk-c7e867793f814a8ba54d93038fa9eb59
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-flash
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash

# === 智谱 GLM (多模态/视觉，产品图片理解专用) ===
ZHIPU_API_KEY=664627b97ca941ebbc3608788ba5c984.UezlghqoJgwmwJLM
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_VISION=glm-4.6v

