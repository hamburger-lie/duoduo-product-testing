APP_ENV=development
APP_NAME=duoduo-product-testing-api
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_me_for_local_development_only
APP_JWT_EXPIRE_DAYS=7
# Local Docker Compose maps PostgreSQL host port 5433 to container port 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/duoduo
# DB 连接池（可选，有默认值）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# Local Docker Compose maps Redis host port 6380 to container port 6379.
REDIS_URL=redis://localhost:6380/0
LOG_LEVEL=INFO
EVALUATION_RUN_MODE=sync
FOLLOWUP_WEBHOOK_URL=
FOLLOWUP_WEBHOOK_SECRET=
FOLLOWUP_WEBHOOK_TIMEOUT_SECONDS=5

# CORS（开发环境用 * ，生产环境改为实际域名，逗号分隔）
CORS_ALLOWED_ORIGINS=*
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://mp.weixin.qq.com

# WeChat mini-program (leave empty to use mock login)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Local dev only: set this to keep WeChat DevTools mock login on one user.
WECHAT_MOCK_OPENID=

# === Whitepaper Proxy Service ===
WHITEPAPER_SERVICE_URL=http://localhost:18001
WHITEPAPER_TIMEOUT_SECONDS=300

# === AI Provider (文本类任务) ===
AI_PROVIDER=mock          # mock | deepseek
# DeepSeek survey generation timeout. Timeout returns an error; it never falls back to local templates.
SURVEY_AI_TIMEOUT_SECONDS=90

# === DeepSeek (文本主力) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-flash
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash

# === 智谱 GLM (多模态/视觉，产品图片理解专用) ===
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_VISION=glm-4.6v

# === 火山方舟 (已废弃，保留字段但不再使用) ===
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_EP_DOUBAO_SEED_16=
# ARK_EP_DOUBAO_15_PRO_CHARACTER=
# ARK_EP_DOUBAO_15_LITE=
# ARK_EP_VISION_PRO=
# ARK_EP_EMBEDDING=
