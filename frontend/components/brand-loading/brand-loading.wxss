.brand-loading {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-loading--small {
  width: 64rpx;
  height: 64rpx;
}

.brand-loading--large {
  width: 120rpx;
  height: 120rpx;
}

.brand-loading__mark {
  width: 100%;
  height: 100%;
  animation: brandLoadingPulseSpin 1.6s ease-in-out infinite;
  transform-origin: 50% 50%;
}

@keyframes brandLoadingPulseSpin {
  0% {
    opacity: 0.72;
    transform: scale(0.92) rotate(0deg);
  }
  50% {
    opacity: 1;
    transform: scale(1.04) rotate(7deg);
  }
  100% {
    opacity: 0.72;
    transform: scale(0.92) rotate(0deg);
  }
}
