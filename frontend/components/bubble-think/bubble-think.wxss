.bt {
  margin: 16rpx 32rpx 16rpx 92rpx;
  padding: 20rpx 24rpx;
  background: var(--accent-soft);
  border: 1rpx dashed var(--border-strong);
  border-radius: 20rpx;
  position: relative;
}
.bt-label {
  font-size: 22rpx;
  color: var(--accent);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.bt-body {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  font-style: italic;
  opacity: 0.85;
}
