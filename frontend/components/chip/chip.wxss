.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  color: var(--text-sub);
  font-size: 26rpx;
  transition: all 0.15s;
}
.chip.selected {
  background: var(--accent-soft);
  border-color: var(--border-strong);
  color: var(--accent);
  font-weight: 500;
}
