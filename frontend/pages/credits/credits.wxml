<view class="page">

  <!-- Balance card -->
  <view class="balance-card">
    <view class="balance-label">当前积分</view>
    <view class="balance-row">
      <view class="balance-coin"></view>
      <text class="balance-num">{{balance}}</text>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="state-center">
    <brand-loading size="large"></brand-loading>
  </view>

  <!-- Empty -->
  <view wx:elif="{{empty}}" class="state-center">
    <view class="empty-icon"></view>
    <text class="empty-text">暂无积分记录</text>
  </view>

  <!-- Transaction list -->
  <view wx:else class="tx-list">
    <view
      wx:for="{{transactions}}"
      wx:key="id"
      class="tx-item"
    >
      <view class="tx-left">
        <text class="tx-desc">{{item.description}}</text>
        <text class="tx-date">{{item.dateStr}}</text>
      </view>
      <view class="tx-right">
        <text class="tx-amount {{item.isIncome ? 'income' : 'expense'}}">
          {{item.isIncome ? '+' : ''}}{{item.amount}}
        </text>
        <text class="tx-balance">余额 {{item.balance_after}}</text>
      </view>
    </view>
  </view>

</view>
