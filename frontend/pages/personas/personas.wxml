<view class="page">
  <view class="top-bar">
    <view class="page-title">我的测品官</view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="state-center">
    <brand-loading size="large"></brand-loading>
  </view>

  <!-- Empty -->
  <view wx:elif="{{personas.length === 0}}" class="state-center">
    <view class="empty-icon"></view>
    <text class="empty-text">还没有自定义测品官</text>
  </view>

  <!-- List -->
  <view wx:else class="list">
    <view
      wx:for="{{personas}}"
      wx:key="id"
      class="pcard"
      data-id="{{item.id}}"
      bind:tap="onTapCard"
    >
      <avatar personaKey="{{item.avatar}}" personaId="{{item.id}}" avatarSlot="{{item.avatarSlot}}" size="{{88}}" />
      <view class="pcard-body">
        <view class="pcard-name">{{item.persona_tag}}</view>
        <view class="pcard-meta">{{item.age}}岁 · {{item.gender === 'female' ? '女' : item.gender === 'male' ? '男' : '未知'}} · {{item.city}}</view>
        <view class="pcard-tag">多角色测品官</view>
      </view>
    </view>
  </view>
</view>
