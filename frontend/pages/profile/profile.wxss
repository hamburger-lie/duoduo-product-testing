.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}
.menu-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* Share item: transparent button overlay */
.share-item { position: relative; }
.share-overlay-btn {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0;
  background: transparent;
  padding: 0; margin: 0;
}
.share-overlay-btn::after { border: none; }

.logout-wrap {
  padding: 0 32rpx;
  margin-top: 16rpx;
}
.logout-btn {
  height: 96rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #EF4444;
  font-weight: 500;
}
.logout-btn:active { opacity: 0.75; }

/* 编辑昵称面板 */
.edit-panel {
  margin-top: 16rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.edit-input {
  height: 72rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}
.edit-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.edit-cancel {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #999;
  border: 1rpx solid #ddd;
}
.edit-save {
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #fff;
  background: #6C63FF;
}
.edit-save.disabled { opacity: 0.5; }
