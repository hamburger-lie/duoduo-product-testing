/* ══════════════════════════════════════════
   UI REFRESH — 顶部区域优化（不改 02 后内容）
══════════════════════════════════════════ */

/* Hero advice: 圆角胶囊 */
.rp-hero-advice {
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  line-height: 1.3;
  max-width: 280rpx;
  background: linear-gradient(90deg, #6D4BFF, #9B72FF);
  white-space: nowrap;
}

/* Top-2 Box 值更大 */
.rp-hero-t2b-value {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  margin-top: 4rpx;
}

/* 三联指标卡：纵向排列，图标隐藏，数字突出 */
.rp-hero-metric {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 6rpx;
  text-align: center;
}

.rp-hero-metric-icon {
  display: none;
}

.rp-hero-metric-label {
  font-size: 22rpx;
  color: #9590A8;
  font-weight: 600;
  margin-top: 0;
  line-height: 1.2;
}

.rp-hero-metric-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #6D4BFF;
  line-height: 1.15;
}

/* 测品结论：彩色圆点替代图片图标 */
.rp-vc-signal-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 3rpx;
}

.rp-vc-signal-dot--pos { background: #10B981; }
.rp-vc-signal-dot--neg { background: #EF4444; }

/* 强制信号行单行省略——pos/neg 必须继承基类的 flex/overflow 规则 */
.rp-vc-signal-text,
.rp-vc-signal-text--pos,
.rp-vc-signal-text--neg {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rp-vc-signal-text--pos {
  color: #059669;
}

.rp-vc-signal-text--neg {
  color: #DC2626;
}

/* 信号容器不允许换行 */
.rp-vc-signal {
  flex-wrap: nowrap;
  overflow: hidden;
}

/* 测品结论主文字加粗突出 */
.rp-vc-body {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
  color: #1A1630;
  margin-bottom: 16rpx;
}

/* 01 机会与阻力：两卡等高，行动建议固定在底部 */
.rp-insight-grid--diagnosis {
  align-items: stretch;
}

.rp-insight-grid--diagnosis .rp-insight-card {
  display: flex;
  flex-direction: column;
}

.rp-insight-action {
  margin-top: auto;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* ══════════════════════════════════════════
   01 机会与阻力 — 轻量决策双卡 (rp-di-*)
   零级联冲突，无 !important
══════════════════════════════════════════ */

/* 双卡容器（旧，已改为 swiper，隐藏保险） */
.rp-di-grid {
  display: none;
}

/* swiper 外层（旧 class，保留兼容） */
.rp-di-swiper-wrap {
  margin-bottom: 8rpx;
}

/* swiper 固定高度 */
.rp-di-swiper {
  height: 390rpx;
}

/* 卡片公共基准 */
.rp-di-card {
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 18rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

/* swiper 内全宽卡片：不撑满，自然高度 */
.rp-di-card--full {
  margin: 0 6rpx;
  height: auto;
}

/* 左卡：近白极浅绿 */
.rp-di-card--pos {
  background: #F9FEFB;
  border: 1rpx solid rgba(34, 197, 94, 0.12);
}

/* 右卡：近白极浅橙 */
.rp-di-card--neg {
  background: #FFFCFA;
  border: 1rpx solid rgba(249, 115, 22, 0.12);
}

/* 标题行 */
.rp-di-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

/* 语义色点 */
.rp-di-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.rp-di-dot--pos { background: #22C55E; }
.rp-di-dot--neg { background: #F97316; }

/* 标题文字 */
.rp-di-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: #1F2937;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 指标列表容器：不撑满，自然排列 */
.rp-di-items {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 单条指标 */
.rp-di-item {
  display: flex;
  flex-direction: column;
}

/* 名称 + pill 同行 */
.rp-di-item-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-bottom: 7rpx;
}

/* 指标名称 */
.rp-di-item-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 人数 pill */
.rp-di-pill {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
}

.rp-di-pill--pos { background: rgba(34, 197, 94, 0.11); }
.rp-di-pill--neg { background: rgba(249, 115, 22, 0.10); }

/* pill 文字 */
.rp-di-pill-text {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.rp-di-pill-text--pos { color: #16A34A; }
.rp-di-pill-text--neg { color: #C2410C; }

/* 进度条底轨 */
.rp-di-track {
  height: 12rpx;
  margin-top: 7rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  overflow: hidden;
}

/* 进度条填充 */
.rp-di-bar {
  height: 100%;
  border-radius: 999rpx;
  transform-origin: left center;
}

/* 展开动画：由 is-growing class 触发 */
.rp-di-bar.is-growing {
  animation: rpProgressGrow 720ms ease-out both;
}

@keyframes rpProgressGrow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

.rp-di-bar--pos { background: #22C55E; }
.rp-di-bar--neg { background: #F97316; }

/* 底部行动建议：浅色背景提示条 */
.rp-di-footer {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.rp-di-footer--pos { background: rgba(34, 197, 94, 0.08); }
.rp-di-footer--neg { background: rgba(249, 115, 22, 0.08); }

/* footer 文字 */
.rp-di-footer-text {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rp-di-footer-text--pos { color: #15803D; }
.rp-di-footer-text--neg { color: #C2410C; }

/* 01 标题行：左侧 index+title，右侧 segmented tabs */
.rp-di-section {
  margin-bottom: 8rpx;
}

.rp-di-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.rp-di-title-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

/* segmented control 外壳 */
.rp-op-tabs {
  display: flex;
  flex-direction: row;
  background: rgba(124, 58, 237, 0.08);
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 6rpx;
}

/* 单个 tab */
.rp-op-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #7C6F9E;
  line-height: 1.2;
  transition: background 0.15s, color 0.15s;
}

/* active：白底 + 阴影 */
.rp-op-tab.is-active {
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
}

/* 机会选中：绿色文字 */
.rp-op-tab.is-opportunity {
  color: #15803D;
}

/* 阻力选中：橙色文字 */
.rp-op-tab.is-risk {
  color: #EA580C;
}

/* ══════════════════════════════════════════
   02 谁会买 — 角色总结发言 & 标签
   只影响 rp-avatar-statement / rp-avatar-tag
══════════════════════════════════════════ */

/* 总结性发言：最多两行，深灰 */
.rp-avatar-statement {
  margin-top: 12rpx;
  font-size: 21rpx;
  font-weight: 500;
  color: #374151;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 关注点标签行 */
.rp-avatar-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 10rpx;
}

/* 单个标签 */
.rp-avatar-tag {
  font-size: 18rpx;
  color: #6B7280;
  background: rgba(107, 114, 128, 0.09);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

/* 弹窗：中性 label（角色判断） */
.rp-flip-label--neutral {
  background: rgba(99, 102, 241, 0.10);
  color: #4F46E5;
}

/* 弹窗：角色想法完整正文，不截断 */
.rp-flip-text--statement {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
  line-height: 1.65;
  white-space: normal;
  overflow: visible;
  /* 明确不截断 */
  display: block;
  -webkit-line-clamp: unset;
  text-overflow: clip;
  margin-top: 16rpx;
}

/* ══════════════════════════════════════════
   03 六维雷达图 — 空状态 / chip / 说明卡
══════════════════════════════════════════ */

/* 空状态提示文字 */
.rp-radar-empty {
  padding: 36rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #B0A8CC;
  line-height: 1.6;
}

/* chip 行 */
.rp-radar-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

/* chip 默认：白底浅紫边 */
.rp-radar-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(109,75,255,0.20);
  background: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  color: #5B4E8A;
  line-height: 1.3;
}

/* chip 选中：紫色浅底 + 紫色边 */
.rp-radar-chip--active {
  background: rgba(109,75,255,0.10);
  border-color: rgba(109,75,255,0.45);
  color: #6D4BFF;
}

/* chip 无数据：置灰 */
.rp-radar-chip--empty {
  border-color: rgba(0,0,0,0.08);
  color: #B0A8CC;
  background: #F7F7FA;
}

/* 无数据 chip 被选中 */
.rp-radar-chip--empty.rp-radar-chip--active {
  background: rgba(0,0,0,0.04);
  border-color: rgba(0,0,0,0.15);
  color: #8C86A3;
}

/* 维度说明卡 */
.rp-radar-detail {
  margin-top: 20rpx;
  background: rgba(109,75,255,0.04);
  border: 1rpx solid rgba(109,75,255,0.09);
  border-radius: 20rpx;
  padding: 20rpx 22rpx 18rpx;
}

/* 说明卡顶行：维度名 + 得分 */
.rp-radar-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.rp-radar-detail-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1F1B3D;
  line-height: 1.2;
}

/* 有数据时分数：紫色大字 */
.rp-radar-detail-score-val {
  font-size: 30rpx;
  font-weight: 900;
  color: #6D4BFF;
  line-height: 1.1;
}

/* 无数据时：灰色小字 */
.rp-radar-detail-score-empty {
  font-size: 25rpx;
  font-weight: 600;
  color: #B0A8CC;
}

/* 说明卡每行 */
.rp-radar-detail-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 14rpx;
}

/* 行标签：小灰字 */
.rp-radar-detail-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #9B96A8;
  line-height: 1.2;
}

/* 行内容 */
.rp-radar-detail-text {
  font-size: 26rpx;
  color: #3E3A55;
  line-height: 1.55;
  white-space: normal;
}

/* ══════════════════════════════════════════
   03 雷达图 — 内嵌浮层交互（v2）
   · radar-visual-wrap  相对定位外容器
   · radar-inside-panel 绝对定位浮层
   · radar-chip-row     压缩 pill 行
   旧大说明卡 rp-radar-detail 改为隐藏
══════════════════════════════════════════ */

/* 隐藏旧外部大说明卡（WXML 已不再渲染，此处保险兜底） */
.rp-radar-detail { display: none; }

/* 外层相对定位容器：280px × 280px，与 canvas 完全等尺寸
   hit-area 百分比定位和 canvas 像素坐标一一对应 */
.radar-visual-wrap {
  position: relative;
  width: 280px;
  height: 280px;
  margin: 0 auto;
  overflow: visible;
}

/* canvas 直接铺满 wrap（absolute 确保不撑高容器） */
.radar-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 280px;
  height: 280px;
  display: block;
  z-index: 1;
}

/* 内嵌说明浮层：绝对定位叠在雷达图底部 */
.radar-inside-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(124, 58, 237, 0.12);
  border-radius: 18rpx;
  padding: 14rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

/* 浮层头行：维度名 + 分数左右排列 */
.radar-inside-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

/* 维度名称 */
.radar-inside-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1F1B3D;
  line-height: 1.2;
  flex-shrink: 1;
  min-width: 0;
}

/* 有数据时分数：紫色加粗 */
.radar-inside-score {
  font-size: 28rpx;
  font-weight: 900;
  color: #6D4BFF;
  line-height: 1.1;
  flex-shrink: 0;
  margin-left: 10rpx;
}

/* 无数据时：灰色小字 */
.radar-inside-score--empty {
  font-size: 22rpx;
  font-weight: 600;
  color: #B0A8CC;
}

/* 解释一句：最多 2 行，紫灰 */
.radar-inside-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 22rpx;
  color: #5B4E8A;
  line-height: 1.5;
  margin-bottom: 4rpx;
  white-space: normal;
}

/* 建议一句：最多 2 行，浅灰 */
.radar-inside-action {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 20rpx;
  color: #9B96A8;
  line-height: 1.45;
  white-space: normal;
}

/* 数据不足时空状态加内边距 */
.rp-radar-empty--pad {
  padding-top: 60rpx;
  padding-bottom: 80rpx;
}

/* 压缩 chip 行 */
.radar-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

/* 覆盖 chip pill 为更小尺寸（chip-row 已从 WXML 移除，此处保留以防万一） */
.radar-chip-row .rp-radar-chip {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

/* ══════════════════════════════════════════
   03 雷达图 — hit-area 节点 & 轻提示（v3）
══════════════════════════════════════════ */

/* 透明点击热区：56rpx×56rpx，负 margin 居中于数据点 */
.radar-node-hit {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  margin-left: -28rpx;
  margin-top: -28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

/* 可见红点：实色，白边，与 canvas 数据节点视觉对齐 */
.radar-node-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #F43F5E;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(244, 63, 94, 0.14);
  box-sizing: border-box;
}

/* 选中态：玫红 pulse 呼吸扩散 */
.radar-node-hit.is-active .radar-node-dot {
  animation: radarDotPulse 1.7s ease-in-out infinite;
}

@keyframes radarDotPulse {
  0%   { box-shadow: 0 0 0 4rpx rgba(244, 63, 94, 0.18); }
  70%  { box-shadow: 0 0 0 14rpx rgba(244, 63, 94, 0); }
  100% { box-shadow: 0 0 0 4rpx rgba(244, 63, 94, 0); }
}

/* ── 气泡卡 ───────────────────────────────────── */
.radar-bubble {
  position: absolute;
  z-index: 60;
  width: 500rpx;
  min-height: 180rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(124, 58, 237, 0.14);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.18);
  animation: radarBubbleIn 0.2s ease-out both;
  box-sizing: border-box;
  pointer-events: auto;
}

/* 气泡出现动画：轻微放大 + 上移渐显 */
@keyframes radarBubbleIn {
  from { opacity: 0; transform: scale(0.96) translateY(8px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* 气泡头行：维度名 + 分数两端对齐 */
.radar-bubble-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.radar-bubble-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #111827;
  line-height: 1.25;
  flex: 1;
  min-width: 0;
}

.radar-bubble-score {
  font-size: 30rpx;
  font-weight: 900;
  color: #7C3AED;
  line-height: 1.25;
  flex-shrink: 0;
}

/* 说明：短句，最多 2 行 */
.radar-bubble-desc {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #374151;
  margin-top: 10rpx;
  white-space: normal;
}

/* 建议：短句，最多 2 行 */
.radar-bubble-action {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #6D28D9;
  margin-top: 12rpx;
  white-space: normal;
}

/* 底部轻提示 */
.radar-tap-hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #7C6F9E;
  line-height: 1.4;
  opacity: 1;
}

/* ══════════════════════════════════════════
   执行摘要区（替代旧 rp-dark-zone + rp-vc）
══════════════════════════════════════════ */

.rp-exec-zone {
  padding: 20rpx 24rpx 18rpx;
  background: #FFFFFF;
}

.rp-exec-card {
  padding: 30rpx 28rpx 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 16rpx 44rpx rgba(109, 75, 255, 0.10);
}

/* 产品名：小标题 */
.rp-exec-product {
  font-size: 28rpx;
  font-weight: 800;
  color: #4B5563;
  line-height: 1.35;
  margin-bottom: 14rpx;
}

/* 主结论：视觉中心——首页判断标题 */
.rp-exec-verdict {
  font-size: 42rpx;
  font-weight: 900;
  color: #171326;
  line-height: 1.32;
  letter-spacing: -0.6rpx;
  margin-bottom: 20rpx;
}

/* 建议胶囊 */
.rp-exec-advice {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7C3AED, #8B5CF6);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 20rpx;
}

/* 评级 + Top-2 Box 核心证据卡 */
.rp-exec-score-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-top: 4rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.05);
  min-height: 126rpx;
}

.rp-exec-score-cell {
  flex: 1;
  text-align: center;
}

/* 右列：flex column 让进度条在标签下方 */
.rp-exec-score-cell--top2 {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rp-exec-score-divider {
  width: 1rpx;
  height: 76rpx;
  background: rgba(124, 58, 237, 0.12);
  flex-shrink: 0;
}

.rp-exec-score-big {
  font-size: 68rpx;
  font-weight: 900;
  color: #171326;
  line-height: 1;
}

.rp-exec-score-big--purple {
  color: #7C3AED;
}

.rp-exec-score-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6B7280;
  line-height: 1.2;
}

/* Top-2 Box 进度条（仅在右列 80% 下方） */
.rp-exec-bar-track {
  width: 188rpx;
  height: 10rpx;
  margin: 12rpx auto 0;
  border-radius: 999rpx;
  background: rgba(124, 58, 237, 0.14);
  overflow: hidden;
}

.rp-exec-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #7C3AED;
}

/* 三联指标卡 */
.rp-exec-metrics {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 18rpx 0;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(124, 58, 237, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
  overflow: hidden;
}

.rp-exec-metric {
  padding: 6rpx 10rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 纯 CSS 小图标 */
.rp-exec-metric-icon {
  width: 30rpx;
  height: 30rpx;
  margin-bottom: 6rpx;
  flex-shrink: 0;
}

/* 购买均值 — 四角星（紫色） */
.rp-exec-metric-icon--score {
  background: #8B5CF6;
  clip-path: polygon(
    50% 0%, 62% 30%, 100% 38%, 70% 62%,
    80% 100%, 50% 76%, 20% 100%, 30% 62%,
    0% 38%, 38% 30%
  );
}

/* 信心度 — 盾牌（绿色） */
.rp-exec-metric-icon--confidence {
  background: #10B981;
  clip-path: polygon(
    50% 0%, 100% 18%, 100% 55%,
    80% 78%, 50% 100%, 20% 78%,
    0% 55%, 0% 18%
  );
}

/* 样本 — 双人（蓝紫色） */
.rp-exec-metric-icon--sample {
  position: relative;
  background: transparent;
}
.rp-exec-metric-icon--sample::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #7C5CFC;
  box-shadow: 12rpx 0 0 0 #A78BFA;
}
.rp-exec-metric-icon--sample::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 20rpx;
  height: 10rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #7C5CFC;
  box-shadow: 10rpx 0 0 0 #A78BFA;
}

.rp-exec-metric + .rp-exec-metric {
  border-left: 1rpx solid rgba(124, 58, 237, 0.10);
}

/* 标签在上 */
.rp-exec-metric-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #6B7280;
  line-height: 1.2;
}

/* 数值在下 */
.rp-exec-metric-value {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #7C3AED;
  line-height: 1.1;
}

/* 拉力 / 阻力依据卡 */
.rp-exec-evidence {
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.rp-exec-evidence-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0;
  line-height: 1.5;
}

.rp-exec-evidence-row + .rp-exec-evidence-row {
  margin-top: 16rpx;
}

.rp-exec-ev-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.rp-exec-ev-dot--pos { background: #10B981; }
.rp-exec-ev-dot--neg { background: #EF4444; }

.rp-exec-ev-label {
  font-size: 30rpx;
  font-weight: 900;
  color: #374151;
  line-height: 1.35;
  flex-shrink: 0;
}

.rp-exec-ev-text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rp-exec-ev-text--pos { color: #16A34A; }
.rp-exec-ev-text--neg { color: #EA580C; }
