page { background: #0D0820; }

.rp-page {
  padding: 0;
  background: transparent;
}

.rp-ready {
  display: flex;
  flex-direction: column;
}

/* ── 暗色区 ── */
.rp-dark-zone {
  padding: 52rpx 24rpx 60rpx;
  background: #F5F0E8;
  background-size: 200% 200%;
  animation: heroBgShift 7s ease-in-out infinite;
}

/* ── 亮色区 ── */
.rp-light-body {
  background: #F5F3FA;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -24rpx;
  padding: 32rpx 24rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}

/* ── State ── */
.rp-state {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.05);
  min-height: 360rpx;
  padding: 60rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  text-align: center;
}
.rp-state--error { border: 2rpx solid #E8E0F3; }
.rp-state-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A2E;
}
.rp-state-hint {
  font-size: 29rpx;
  color: #817B91;
}

/* ══════════════════════════════════════════
   HERO / DASHBOARD
══════════════════════════════════════════ */
@keyframes heroBgShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.rp-hero {
  position: relative;
  overflow: hidden;
}

/* animated orbs */
.rp-hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.rp-hero-orb--1 {
  width: 320rpx;
  height: 320rpx;
  top: -90rpx;
  right: -70rpx;
  background: radial-gradient(circle, rgba(124,92,252,0.42), transparent 70%);
  animation: orbFloat 5.5s ease-in-out infinite;
}
.rp-hero-orb--2 {
  width: 280rpx;
  height: 280rpx;
  bottom: -70rpx;
  left: -50rpx;
  background: radial-gradient(circle, rgba(56,130,245,0.22), transparent 70%);
  animation: orbFloat 7s ease-in-out infinite reverse;
}
@keyframes orbFloat {
  0%, 100% { opacity: 0.5; transform: scale(0.94); }
  50%       { opacity: 1;   transform: scale(1.10); }
}

/* top row */
.rp-hero-toprow {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rp-hero-verdict-chip {
  flex: 1;
  min-width: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124,92,252,0.45);
  background: rgba(124,92,252,0.18);
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.92);
}
.rp-hero-grade {
  flex-shrink: 0;
  font-size: 100rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
  color: #1A1A2E;
}

/* product name */
.rp-hero-name {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A2E;
  line-height: 1.35;
}

/* consensus bar */
.rp-hero-bar-wrap {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(0,0,0,0.1);
}
.rp-hero-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.rp-hero-bar-label {
  font-size: 26rpx;
  color: #5A5372;
  font-weight: 600;
}
.rp-hero-bar-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #1A1A2E;
}
.rp-hero-bar-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,0.1);
  overflow: hidden;
}
.rp-hero-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #9B8FD4, #7C5CFC);
}

/* ══ Evidence strip ══ */
.rp-ev-strip {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
  margin-top: 24rpx;
}
.rp-ev-strip::-webkit-scrollbar { display: none; }
.rp-ev-chip {
  flex-shrink: 0;
  min-width: 148rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124,92,252,0.12);
  background: #FFFFFF;
  padding: 22rpx 24rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(124,92,252,0.07);
}
.rp-ev-val {
  font-size: 44rpx;
  font-weight: 800;
  color: #120A2E;
  line-height: 1;
  letter-spacing: -1rpx;
}
.rp-ev-label {
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
  font-weight: 500;
}

/* ══════════════════════════════════════════
   CARD SUMMARY SECTIONS
══════════════════════════════════════════ */

/* 测品结论 */
.rp-vc {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.07);
  padding: 28rpx 28rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06);
}
.rp-vc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.02em;
  margin-bottom: 14rpx;
}
.rp-vc-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #0F172A;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.rp-vc-body {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.75;
  color: #1E293B;
  letter-spacing: -0.01em;
}
.rp-vc-hl {
  display: inline;
  background: #F1F0FF;
  color: #3730A3;
  font-weight: 700;
  border-radius: 6rpx;
  padding: 0 6rpx;
}

/* 消费群体评分 */
.rp-ps-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.07);
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06);
}
.rp-ps-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.rp-ps-titles { flex: 1; }
.rp-ps-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.03em;
}
.rp-ps-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #8B5CF6;
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #F3EEFF;
  font-weight: 600;
}
.rp-ps-arrow {
  font-size: 28rpx;
  line-height: 1;
}
.rp-ps-strip {
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  padding-bottom: 4rpx;
}
.rp-ps-strip::-webkit-scrollbar { display: none; }
.rp-ps-track {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  min-width: 100%;
}
.rp-ps-card {
  flex-shrink: 0;
  width: 560rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 1rpx solid #F1F5F9;
  background: #FFFFFF;
  padding: 22rpx 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 8rpx 28rpx rgba(15,23,42,0.045);
}
.rp-ps-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  text-align: center;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
}
.rp-ps-score {
  font-size: 48rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.04em;
  line-height: 1.1;
}
.rp-ps-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #F8FAFC;
  font-size: 24rpx;
  font-weight: 500;
  color: #64748B;
  margin-top: 4rpx;
}

/* 核心亮点 + 风险提醒 */
.rp-insight-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.rp-insight-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.07);
  padding: 24rpx 18rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06);
}
.rp-insight-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.03em;
  margin-bottom: 18rpx;
}
.rp-insight-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.rp-insight-item:last-child { margin-bottom: 0; }
.rp-insight-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
}
.rp-insight-icon--pos {
  color: #10B981;
  border: 2rpx solid #10B981;
}
.rp-insight-icon--neg {
  color: #F43F5E;
  border: 0;
  border-radius: 0;
}
.rp-insight-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.75;
  color: #334155;
  font-weight: 600;
}

/* 下一步动作 */
.rp-action-card {
  background: #F7F5FF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(124,92,252,0.1);
  padding: 28rpx;
}
.rp-action-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.rp-action-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #EDE9FE;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rp-action-icon-sym {
  font-size: 32rpx;
  color: #7C3AED;
  line-height: 1;
}
.rp-action-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.02em;
}
.rp-action-rows { display: flex; flex-direction: column; gap: 0; }
.rp-action-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(124,92,252,0.08);
  font-size: 30rpx;
  line-height: 1.5;
}
.rp-action-row:first-child { padding-top: 0; }
.rp-action-row:last-child { border-bottom: none; padding-bottom: 0; }
.rp-action-key {
  font-weight: 700;
  color: #6B7280;
  min-width: 120rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1.75;
}
.rp-action-val { flex: 1; color: #0F172A; font-size: 30rpx; line-height: 1.75; }
.rp-action-val--accent { color: #0F172A; font-weight: 600; }

/* ── kept for 购买意愿分布 section ── */
.rp-score-bar-track {
  margin: 14rpx auto 0;
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(124, 92, 252, 0.12);
  overflow: hidden;
}
.rp-score-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #A78BFA, #7C5CFC);
  transition: width 0.6s ease;
}

/* Business signals */
.rp-signals {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}
.rp-signal {
  flex: 1;
  background: rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 14rpx;
  padding: 14rpx 10rpx;
  text-align: center;
}
.rp-signal--active {
  background: rgba(124,92,252,0.08);
  border-color: rgba(124,92,252,0.25);
}
.rp-signal-label {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
}
.rp-signal-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #000000;
}
.rp-signal--active .rp-signal-value { color: #7C5CFC; }

/* ── 综合评分看板（游戏战报样式）─────────────────── */
.rp-stat-board {
  margin-top: 32rpx;
}

.rp-stat-board-top {
  position: relative;
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rp-stat-corner {
  position: absolute;
}
.rp-stat-corner--tl { top: 0; left: 0; }
.rp-stat-corner--tr { top: 0; right: 0; text-align: right; align-items: flex-end; }
.rp-stat-corner--bl { bottom: 0; left: 0; }
.rp-stat-corner--br { bottom: 0; right: 0; text-align: right; align-items: flex-end; }

.rp-stat-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.rp-stat-score {
  font-size: 128rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
  background: linear-gradient(135deg, #C4B8E8, #A78BFA, #9B8FD4, #7C5CFC, #A78BFA, #C4B8E8);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradeShift 4s ease infinite;
}

@keyframes gradeShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.rp-stat-badge {
  margin-top: 14rpx;
  padding: 6rpx 22rpx;
  background: rgba(124,92,252,0.12);
  border: 1rpx solid rgba(124,92,252,0.35);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #7C5CFC;
  font-weight: 600;
}

.rp-stat-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rp-stat-item--r {
  align-items: flex-end;
}

.rp-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.1;
}

.rp-stat-lbl {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
}

.rp-stat-board-bottom {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.rp-stat-item--b {
  flex: 1;
  align-items: center;
  text-align: center;
}

.rp-stat-item--b .rp-stat-num {
  font-size: 44rpx;
}

.rp-stat-sep {
  width: 1rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.1);
}

/* Verdict reason */
.rp-hero-reason {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.65);
  line-height: 1.65;
}

/* ══════════════════════════════════════════
   SECTION SHELL
══════════════════════════════════════════ */
.rp-section {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 26, 46, 0.04);
  padding: 30rpx 28rpx;
}
.rp-section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.3;
  margin-bottom: 20rpx;
}
.rp-section-subtitle {
  margin-top: -10rpx;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  color: #5F5870;
  line-height: 1.45;
}

/* ── Summary ── */
.rp-summary-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.rp-summary-item {
  font-size: 30rpx;
  color: #4C485E;
  line-height: 1.65;
  padding-left: 16rpx;
  border-left: 4rpx solid #C4B8E8;
}

/* ── Focus cards ── */
.rp-focus-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.rp-focus {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #FBFAFF;
  border: 1rpx solid #E8E0F3;
}
.rp-focus-label {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
  color: #6F5B99;
  font-size: 26rpx;
  font-weight: 800;
}
.rp-focus-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #252139;
  line-height: 1.35;
}
.rp-focus-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #625D70;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ══════════════════════════════════════════
   1b. 评分拆解
══════════════════════════════════════════ */
.rp-sbd-table {
  display: flex;
  flex-direction: column;
}
.rp-sbd-header {
  display: flex;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #EDE9F6;
  margin-bottom: 4rpx;
}
.rp-sbd-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F0FA;
}
.rp-sbd-row:last-child { border-bottom: none; }
.rp-sbd-col {
  font-size: 28rpx;
  line-height: 1.4;
}
.rp-sbd-col--dim {
  flex: 1;
  color: #2D2940;
  font-weight: 600;
}
.rp-sbd-col--num {
  width: 110rpx;
  text-align: center;
  flex-shrink: 0;
  color: #2D2940;
  font-weight: 600;
}
.rp-sbd-header .rp-sbd-col {
  color: #8C86A3;
  font-weight: 700;
  font-size: 26rpx;
}
.rp-sbd-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: #FFFBEC;
  border-radius: 12rpx;
  border: 1rpx solid #F5E9A0;
  font-size: 27rpx;
  color: #6B5E2E;
  line-height: 1.65;
}

/* ══════════════════════════════════════════
   1c. 六维表现雷达图
══════════════════════════════════════════ */
.rp-radar-canvas-box {
  background: #FAFAFA;
  border-radius: 14rpx;
  padding: 20rpx 0 12rpx;
  margin-bottom: 20rpx;
}
.rp-radar-tap-hint {
  text-align: center;
  font-size: 26rpx;
  color: #B0A8CC;
  margin-top: 6rpx;
  padding-bottom: 4rpx;
}
.rp-radar-bars {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.rp-radar-bar-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.rp-radar-bar-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
  overflow: hidden;
}
.rp-radar-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #DC3864;
  transition: width 0.6s ease;
}
.rp-radar-bar-val {
  width: 72rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #DC3864;
  flex-shrink: 0;
}

/* ══════════════════════════════════════════
   2. 消费者群体热力矩阵
══════════════════════════════════════════ */
.rp-hm-wrap {
  display: flex;
  flex-direction: column;
}
.rp-hm-header-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 52rpx;
}
.rp-hm-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 60rpx;
}
.rp-hm-row-label {
  width: 160rpx;
  min-width: 160rpx;
  font-size: 24rpx;
  color: #4A3F7A;
  font-weight: 600;
  padding-right: 10rpx;
  display: flex;
  align-items: center;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rp-hm-row-label--header {
  /* spacer, no content */
}
.rp-hm-col-header {
  flex: 1;
  font-size: 26rpx;
  color: #0F172A;
  font-weight: 400;
  text-align: center;
  padding: 6rpx 2rpx;
  line-height: 1.3;
  word-break: break-all;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.rp-hm-cell {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rp-hm-cell-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.rp-hm-legend {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-left: 160rpx;
}
.rp-hm-legend-bar {
  width: 100rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgb(240,230,208), rgb(124,92,252));
}
.rp-hm-legend-label {
  font-size: 27rpx;
  font-weight: 400;
  color: #0F172A;
}
.rp-hm-legend-unit {
  font-size: 27rpx;
  color: #0F172A;
  font-weight: 400;
  margin-left: 6rpx;
}

/* ══════════════════════════════════════════
   3. STACKED BAR
══════════════════════════════════════════ */
.rp-stacked-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx 10rpx;
  margin-bottom: 20rpx;
}
.rp-stacked-t2b {
  font-size: 30rpx;
  font-weight: 800;
  color: #7C3AED;
  line-height: 1.75;
}
.rp-stacked-hint {
  font-size: 30rpx;
  color: #7B7499;
  line-height: 1.75;
}
.rp-score-bars {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rp-score-bar-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.rp-score-bar-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rp-score-bar-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.rp-score-bar-name {
  font-size: 30rpx;
  color: #4C485E;
  font-weight: 600;
  line-height: 1.75;
}
.rp-score-bar-count {
  font-size: 30rpx;
  color: #7B7499;
  margin-left: auto;
  line-height: 1.75;
}
.rp-score-bar-track {
  height: 36rpx;
  background: #F3F0FF;
  border-radius: 10rpx;
  overflow: hidden;
}
.rp-score-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  padding-left: 14rpx;
  transition: width 0.6s ease;
  min-width: 60rpx;
  box-sizing: border-box;
}
.rp-score-bar-val {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.95);
  white-space: nowrap;
}

/* ══════════════════════════════════════════
   4. DIMENSION BARS
══════════════════════════════════════════ */
.rp-dim-bench-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #7B7499;
  margin-bottom: 16rpx;
}
.rp-bench-dot-icon {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7C5CFC;
  flex-shrink: 0;
}
.rp-dim-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.rp-dim-row:last-child { margin-bottom: 0; }
.rp-dim-label {
  width: 128rpx;
  font-size: 30rpx;
  color: #4C485E;
  flex-shrink: 0;
  line-height: 1.75;
}
.rp-dim-track {
  flex: 1;
  position: relative;
  height: 14rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
  overflow: visible;
}
.rp-dim-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}
.rp-dim-fill--above {
  background: linear-gradient(90deg, #A78BFA, #7C3AED);
}
.rp-dim-fill--below {
  background: linear-gradient(90deg, #A78BFA, #7C5CFC);
}
.rp-dim-bench-marker {
  position: absolute;
  top: -4rpx;
  width: 6rpx;
  height: 22rpx;
  background: #7C5CFC;
  border-radius: 3rpx;
  transform: translateX(-50%);
}
.rp-dim-value {
  width: 52rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: #9C8CB8;
  flex-shrink: 0;
  line-height: 1.75;
}
.rp-dim-value--above { color: #7C3AED; }

/* ══════════════════════════════════════════
   5. HEATMAP
══════════════════════════════════════════ */
.rp-heatmap-scroll {
  width: 100%;
}
.rp-heatmap {
  display: inline-flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 100%;
}
.rp-hm-header-row,
.rp-hm-data-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.rp-hm-corner {
  width: 130rpx;
  flex-shrink: 0;
}
.rp-hm-col-head {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #7B7499;
  text-align: center;
  font-weight: 700;
  line-height: 1.3;
}
.rp-hm-row-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #4C485E;
  line-height: 1.3;
  padding-right: 6rpx;
}
.rp-hm-cell {
  width: 100rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}
.rp-hm-cell--h-high { background: rgba(124,92,252,0.12); color: #7C5CFC; }
.rp-hm-cell--h-mid  { background: rgba(124,92,252,0.12); color: #5A4E9C; }
.rp-hm-cell--h-low  { background: rgba(61,46,124,0.15);  color: #3D2E7C; }
.rp-hm-legend {
  margin-top: 16rpx;
  display: flex;
  gap: 20rpx;
}
.rp-hm-leg-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #5F5870;
}
.rp-hm-leg-swatch {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

/* ══════════════════════════════════════════
   6. CLAIM EFFECTIVENESS
══════════════════════════════════════════ */
/* ══ 卖点与顾虑（纵向发散柱状图）══ */
.rp-dv-chart {
  position: relative;
  margin-top: 16rpx;
}

.rp-dv-inner {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.rp-dv-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rp-dv-top {
  height: 180rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.rp-dv-bottom {
  height: 180rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.rp-dv-bar {
  width: 60%;
  border-radius: 4rpx;
  min-height: 6rpx;
}

.rp-dv-bar--pos {
  border-radius: 4rpx 4rpx 0 0;
  background: linear-gradient(180deg, #A78BFA 0%, #7C3AED 100%);
}

.rp-dv-bar--neg {
  border-radius: 0 0 4rpx 4rpx;
  background: linear-gradient(180deg, #E83A5A 0%, #B91C3A 100%);
}

.rp-dv-lbl {
  font-size: 22rpx;
  color: #9B96A8;
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  word-break: break-all;
  padding: 0 2rpx;
}

.rp-dv-lbl--above {
  height: 48rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6rpx;
}

.rp-dv-lbl--below {
  height: 48rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 6rpx;
}

.rp-dv-lbl--spacer {
  height: 48rpx;
}

.rp-dv-axis {
  position: absolute;
  top: 228rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #D0C8E8;
  pointer-events: none;
}

/* ══ 卖点与顾虑（合并区块）══ */
.rp-signal-group {
  margin-bottom: 24rpx;
}
.rp-signal-group:last-child { margin-bottom: 0; }
.rp-signal-group--neg { margin-top: 8rpx; }
.rp-signal-group-header {
  font-size: 26rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}
.rp-signal-group-header--pos {
  background: rgba(124,92,252,0.08);
  color: #7C5CFC;
}
.rp-signal-group-header--neg {
  background: rgba(61,46,124,0.08);
  color: #3D2E7C;
}
.rp-signal-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0EEF4;
}
.rp-signal-item:last-child { border-bottom: none; padding-bottom: 0; }
.rp-signal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #252139;
  line-height: 1.4;
  margin-bottom: 10rpx;
}
.rp-signal-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rp-signal-track {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
  overflow: hidden;
}
.rp-signal-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.5s ease;
}
.rp-signal-fill--pos { background: linear-gradient(90deg, #A78BFA, #7C3AED); }
.rp-signal-fill--neg { background: linear-gradient(90deg, #9B8FD4, #3D2E7C); }
.rp-signal-pct {
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  min-width: 56rpx;
  text-align: right;
}
.rp-signal-pct--pos { color: #7C5CFC; }
.rp-signal-pct--neg { color: #3D2E7C; }

/* ══════════════════════════════════════════
   7. THEME BUBBLES
══════════════════════════════════════════ */
.rp-bubbles-section { margin-bottom: 20rpx; }
.rp-bubbles-section:last-child { margin-bottom: 0; }
.rp-bubbles-label {
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.rp-bubbles-label--pos { color: #7C5CFC; }
.rp-bubbles-label--neg { color: #3D2E7C; }
.rp-bubbles-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rp-bubble {
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 16rpx;
  text-align: center;
}
.rp-bubble--sm { min-width: 120rpx; }
.rp-bubble--md { min-width: 160rpx; }
.rp-bubble--lg { min-width: 200rpx; }
.rp-bubble--pos { background: rgba(124,92,252,0.08); border: 1rpx solid rgba(124,92,252,0.2); }
.rp-bubble--neg { background: rgba(61,46,124,0.08); border: 1rpx solid rgba(61,46,124,0.2); }
.rp-bubble-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}
.rp-bubble--pos .rp-bubble-title { color: #7C5CFC; }
.rp-bubble--neg .rp-bubble-title { color: #3D2E7C; }
.rp-bubble-count {
  margin-top: 4rpx;
  font-size: 26rpx;
}
.rp-bubble--pos .rp-bubble-count { color: rgba(124,92,252,0.7); }
.rp-bubble--neg .rp-bubble-count { color: rgba(61,46,124,0.7); }

/* ══════════════════════════════════════════
   8. CON BARS
══════════════════════════════════════════ */

/* ══════════════════════════════════════════
   9. PRICE PIE
══════════════════════════════════════════ */
.rp-price-chart {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.rp-price-pie {
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(124, 58, 237, 0.08);
}
.rp-price-pie-center {
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.rp-price-total {
  font-size: 34rpx;
  font-weight: 800;
  color: #2D2940;
  line-height: 1;
}
.rp-price-total-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8C86A3;
  line-height: 1;
}
.rp-price-legend {
  flex: 1;
  min-width: 0;
}
.rp-price-row {
  display: grid;
  grid-template-columns: 18rpx minmax(96rpx, 1fr) 72rpx 68rpx;
  align-items: center;
  column-gap: 12rpx;
  margin-bottom: 14rpx;
}
.rp-price-row:last-child { margin-bottom: 0; }
.rp-price-swatch {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.rp-price-label {
  font-size: 27rpx;
  color: #4C485E;
  line-height: 1.3;
}
.rp-price-pct {
  text-align: right;
  font-size: 28rpx;
  font-weight: 800;
  color: #2D2940;
}
.rp-price-count {
  text-align: right;
  font-size: 26rpx;
  color: #8C86A3;
}
.rp-price-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #B0A8CC;
  line-height: 1.6;
}

/* ══════════════════════════════════════════
   UNUSED BENCHMARK STYLES
══════════════════════════════════════════ */
.rp-bench-legend {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.rp-bench-source {
  font-size: 25rpx;
  color: #B0A8CC;
  margin-bottom: 18rpx;
  line-height: 1.5;
}
.rp-bench-leg-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #4C485E;
}
.rp-bench-swatch {
  width: 20rpx;
  height: 10rpx;
  border-radius: 5rpx;
}
.rp-bench-swatch--us    { background: #7C3AED; }
.rp-bench-swatch--bench { background: #7C5CFC; }
.rp-bench-row {
  margin-bottom: 20rpx;
}
.rp-bench-row:last-child { margin-bottom: 0; }
.rp-bench-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #4C485E;
  margin-bottom: 8rpx;
}
.rp-bench-bars {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.rp-bench-bar-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rp-bench-bar-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
  overflow: hidden;
}
.rp-bench-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}
.rp-bench-bar-fill--us    { background: linear-gradient(90deg, #A78BFA, #7C3AED); }
.rp-bench-bar-fill--bench { background: rgba(61,46,124,0.55); }
.rp-bench-val {
  width: 40rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: #7B7499;
  flex-shrink: 0;
}
.rp-bench-val--above { color: #7C3AED; }
.rp-bench-val--below { color: #7C5CFC; }

/* ══════════════════════════════════════════
   11. PRIORITY MATRIX
══════════════════════════════════════════ */
.rp-matrix {
  position: relative;
  background: #FAF9FC;
  border: 1rpx solid #ECE8F3;
  border-radius: 16rpx;
  padding: 20rpx;
}
.rp-matrix-axis-top {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #4C465C;
  font-weight: 700;
}
.rp-matrix-inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.rp-matrix-inner::before,
.rp-matrix-inner::after {
  content: "";
  position: absolute;
  background: rgba(88, 80, 116, 0.12);
  z-index: 1;
}
.rp-matrix-inner::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
}
.rp-matrix-inner::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
}
.rp-matrix-cell {
  position: relative;
  z-index: 2;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 206rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
}
.rp-matrix-cell--tl {
  background: linear-gradient(180deg, #F5F1FB, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #3D2E7C;
}
.rp-matrix-cell--tr {
  background: linear-gradient(180deg, #F0EDF7, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #7C5CFC;
}
.rp-matrix-cell--bl {
  background: linear-gradient(180deg, #F7F7F9, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #A7A4B4;
}
.rp-matrix-cell--br {
  background: linear-gradient(180deg, #F5F2FF, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #7C3AED;
}
.rp-matrix-cell-badge {
  display: inline-block;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}
.rp-matrix-cell-badge--warn    { background: rgba(61,46,124,0.1);   color: #3D2E7C; }
.rp-matrix-cell-badge--good    { background: rgba(124,92,252,0.12); color: #7C5CFC; }
.rp-matrix-cell-badge--neutral { background: rgba(124,92,252,0.1);  color: #4C485E; }
.rp-matrix-cell-badge--purple  { background: rgba(124,58,237,0.1);  color: #5B21B6; }
.rp-matrix-cell-hint {
  font-size: 27rpx;
  color: #5E566D;
  margin-bottom: 16rpx;
  line-height: 1.3;
}
.rp-matrix-item {
  padding: 18rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(226, 222, 236, 0.88);
  margin-bottom: 12rpx;
}
.rp-matrix-item:last-child { margin-bottom: 0; }
.rp-matrix-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}
.rp-matrix-item-title {
  flex: 1;
  font-size: 31rpx;
  font-weight: 800;
  color: #2A263B;
  line-height: 1.42;
}
.rp-matrix-item-pct {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 900;
  color: #241B46;
  line-height: 1.2;
}
.rp-matrix-item-meta {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #4F485C;
  line-height: 1.45;
}
.rp-matrix-empty {
  padding: 42rpx 0 28rpx;
  font-size: 28rpx;
  color: #625B70;
  text-align: center;
}
.rp-matrix-axis-x {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 4rpx;
  font-size: 28rpx;
  color: #4C465C;
  font-weight: 700;
}

/* ══════════════════════════════════════════
   MARKETING ANGLES
══════════════════════════════════════════ */
.rp-angle-card {
  background: #FBFAFF;
  border: 1rpx solid #EAE4F4;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}
.rp-angle-card:last-child { margin-bottom: 0; }
.rp-angle-angle {
  font-size: 30rpx;
  font-weight: 700;
  color: #252139;
  line-height: 1.5;
}
.rp-angle-meta {
  margin-top: 8rpx;
}
.rp-angle-seg {
  font-size: 27rpx;
  color: #7C3AED;
}
.rp-angle-risk {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5A4E9C;
  background: rgba(124,92,252,0.1);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  line-height: 1.5;
}

/* ── Audience/channels ── */
.rp-audience-block {
  margin-bottom: 20rpx;
}
.rp-audience-block:last-child { margin-bottom: 0; }
.rp-audience-label {
  font-size: 27rpx;
  font-weight: 700;
  color: #6B667A;
  margin-bottom: 10rpx;
}
.rp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rp-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.rp-tag--pos { background: rgba(124,92,252,0.12); color: #7C5CFC; }
.rp-tag--neg { background: rgba(61,46,124,0.1);  color: #3D2E7C; }
.rp-channel {
