/* ══════════════════════════════════════════
   翻转弹窗 Overlay Modal
══════════════════════════════════════════ */
.rp-flip-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.rp-flip-card {
  width: 100%;
  max-width: 620rpx;
  animation: rp-card-flip 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}
@keyframes rp-card-flip {
  0%   { transform: rotateX(90deg) scale(0.85); opacity: 0; }
  60%  { opacity: 1; }
  100% { transform: rotateX(0deg) scale(1); opacity: 1; }
}
.rp-flip-detail {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.06);
  padding: 32rpx 28rpx;
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 20rpx 60rpx rgba(15,23,42,0.18);
  position: relative;
}
.rp-flip-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #94A3B8;
  font-weight: 300;
}
.rp-flip-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.rp-avatar-img--sm {
  width: 112rpx !important;
  height: 112rpx !important;
  border-radius: 50% !important;
  flex-shrink: 0 !important;
}
.rp-flip-id {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.rp-flip-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1F1B3D;
  line-height: 1.2;
}
.rp-flip-score {
  font-size: 23rpx;
  font-weight: 700;
  color: #7C5CFC;
}
.rp-flip-section {
  margin-bottom: 20rpx;
}
.rp-flip-section:last-child {
  margin-bottom: 0;
}
.rp-flip-label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
}
.rp-flip-label--pos {
  background: rgba(16,185,129,0.1);
  color: #059669;
}
.rp-flip-label--neg {
  background: rgba(244,63,94,0.1);
  color: #E11D48;
}
.rp-flip-text {
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.65;
  font-weight: 500;
  margin-top: 8rpx;
  letter-spacing: 0;
  opacity: 1;
}

