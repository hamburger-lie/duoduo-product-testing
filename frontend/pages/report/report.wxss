.rp-attr-quote--neg .rp-attr-name { color: #3D2E7C; }
.rp-attr-text {
  font-size: 30rpx;
  color: #403B54;
  line-height: 1.65;
}

/* ── Plain quotes (fallback) ── */
.rp-quote {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #F8F7FA;
  color: #403B54;
  font-size: 30rpx;
  line-height: 1.65;
  margin-bottom: 14rpx;
}
.rp-quote:last-child { margin-bottom: 0; }

/* ── Steps ── */
.rp-step {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.rp-step:last-child { margin-bottom: 0; }
.rp-step-num {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #241B46;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.rp-step-text {
  flex: 1;
  font-size: 30rpx;
  color: #4C485E;
  line-height: 1.55;
}

/* ── Actions ── */
.rp-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rp-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  padding: 0;
}
.rp-btn::after { border: none; }
.rp-btn--primary {
  background: #241B46;
  color: #fff;
}
.rp-btn--ghost {
  background: #fff;
  color: #241B46;
  border: 2rpx solid #DED9EA;
}

/* ── Disclaimer ── */
