.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  line-height: 1;
  background: #F4F0FF;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.avatar.ring {
  box-shadow:
    0 0 0 4rpx rgba(123,111,168,0.35),
    0 0 24rpx rgba(123,111,168,0.20);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
