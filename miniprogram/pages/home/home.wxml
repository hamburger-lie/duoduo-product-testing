<view class="page">
  <view class="bg-blob b1"></view>
  <view class="bg-blob b2"></view>
  <view class="bg-blob b3"></view>

  <!-- Header -->
  <view class="header">
    <view class="brand">测品官</view>
  </view>

  <!-- Scene -->
  <view class="scene">

    <!-- Hero image, large, background-blended -->
    <image class="hero-img" src="/assets/hero.png" mode="aspectFit"/>

    <!-- Draggable + floating bubble cards -->
    <movable-area class="bubble-field">

      <movable-view
        wx:for="{{bubbles}}"
        wx:key="id"
        direction="all"
        x="{{item.x}}"
        y="{{item.y}}"
        inertia
        out-of-bounds
        class="mv"
      >
        <view class="bubble-emerge emerge-{{item.floatClass}}">
          <view class="bub {{item.floatClass}}" data-id="{{item.id}}" bind:tap="onTapBubble">
            <avatar personaKey="{{item.personaKey}}" personaId="{{item.id}}" slot="{{item.avatarSlot}}" size="{{68}}" />
            <view class="binfo">
              <view class="bname">{{item.group}}</view>
              <view class="brole">{{item.label}}</view>
            </view>
          </view>
        </view>
      </movable-view>

    </movable-area>
  </view>

  <!-- CTA: fixed color + flowing gradient border -->
  <view class="cta-outer" bind:tap="onTapCreate">
    <view class="cta-inner">
      <text class="cta-text">开始调研</text>
    </view>
  </view>

</view>
