/* ===== 首页样式 ===== */
page {
  background: #EDE8F8;
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 88rpx 0 60rpx;
  background: linear-gradient(160deg, #EDE8F8 0%, #F8F6FE 55%, #EBE5F5 100%);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* Background blobs */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
  z-index: 0;
}
.b1 { width: 420rpx; height: 420rpx; background: rgba(155,139,208,0.22); top: -100rpx; right: -80rpx; }
.b2 { width: 300rpx; height: 300rpx; background: rgba(100,149,237,0.14); bottom: 160rpx; left: -80rpx; }
.b3 { width: 220rpx; height: 220rpx; background: rgba(208,112,176,0.12); top: 42%; right: -40rpx; }

/* ── Header ── */
.header {
  text-align: center;
  position: relative;
  z-index: 2;
  padding: 0 40rpx;
  flex-shrink: 0;
}
.brand {
  font-size: 80rpx;
  font-weight: 800;
  color: #1A1A2E;
  letter-spacing: 5rpx;
  line-height: 1;
}
.tagline {
  font-size: 25rpx;
  color: #7B6FA8;
  font-weight: 500;
  margin-top: 14rpx;
  letter-spacing: 0.5rpx;
}

/* ── Stats row ── */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(16px);
  border-radius: 40rpx;
  border: 1.5rpx solid rgba(255,255,255,0.8);
  padding: 18rpx 48rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 2;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 0 36rpx;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #5A4E9C;
  line-height: 1;
}
.stat-label {
  font-size: 22rpx;
  color: #8E84B8;
}
.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(123,111,168,0.2);
}

/* ── Scene ── */
.scene {
  flex: 1;
  width: 100%;
  position: relative;
  overflow: hidden;
  min-height: 0;
}

/* Hero image — background blended away via multiply (works best with white-bg PNG;
   for perfect results export the character as transparent-background PNG) */
.hero-img {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -52%);
  width: 640rpx;
  height: 800rpx;
  z-index: 1;
  mix-blend-mode: multiply;
  filter: brightness(1.08) contrast(1.04);
  pointer-events: none;
}

/* Bubble field covers full scene */
.bubble-field {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 900rpx;
  background: transparent;
  z-index: 2;
}

/* movable-view wrapper — no styling, just size */
.mv {
  width: 286rpx;
  height: auto;
}
.bubble-emerge {
  opacity: 0;
  transform-origin: 50% 50%;
}
.emerge-fa { animation: emergeA 780ms cubic-bezier(0.18, 0.9, 0.22, 1.05) 80ms both; }
.emerge-fb { animation: emergeB 860ms cubic-bezier(0.18, 0.9, 0.22, 1.05) 180ms both; }
.emerge-fc { animation: emergeC 900ms cubic-bezier(0.18, 0.9, 0.22, 1.05) 260ms both; }
.emerge-fd { animation: emergeD 940ms cubic-bezier(0.18, 0.9, 0.22, 1.05) 340ms both; }
.emerge-fe { animation: emergeE 980ms cubic-bezier(0.18, 0.9, 0.22, 1.05) 420ms both; }

@keyframes emergeA {
  0%   { opacity: 0; transform: translate(134rpx, 229rpx) scale(0.36); }
  68%  { opacity: 1; transform: translate(-8rpx, -6rpx) scale(1.04); }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}
@keyframes emergeB {
  0%   { opacity: 0; transform: translate(-312rpx, 100rpx) scale(0.36); }
  68%  { opacity: 1; transform: translate(8rpx, -6rpx) scale(1.04); }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}
@keyframes emergeC {
  0%   { opacity: 0; transform: translate(134rpx, -38rpx) scale(0.36); }
  68%  { opacity: 1; transform: translate(-8rpx, 6rpx) scale(1.04); }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}
@keyframes emergeD {
  0%   { opacity: 0; transform: translate(-310rpx, -226rpx) scale(0.36); }
  68%  { opacity: 1; transform: translate(8rpx, 6rpx) scale(1.04); }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}
@keyframes emergeE {
  0%   { opacity: 0; transform: translate(72rpx, -346rpx) scale(0.36); }
  68%  { opacity: 1; transform: translate(-6rpx, 8rpx) scale(1.04); }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}

/* ── Bubble card ── */
.bub {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 15rpx;
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 54rpx;
  padding: 17rpx 23rpx 17rpx 17rpx;
  width: 286rpx;
  box-sizing: border-box;
  box-shadow:
    0 6rpx 28rpx rgba(100,80,160,0.16),
    0 1rpx 6rpx rgba(0,0,0,0.06);
  border: 1.5rpx solid rgba(255,255,255,0.90);
}

/* 6 unique float animations — different amplitude, direction, rotation, timing */
@keyframes floatA {
  0%, 100% { transform: translateY(0) rotate(-0.6deg); }
  55%       { transform: translateY(-18rpx) rotate(0.8deg); }
}
@keyframes floatB {
  0%, 100% { transform: translateY(-5rpx) rotate(1deg); }
  50%       { transform: translateY(10rpx) rotate(-0.4deg); }
}
@keyframes floatC {
  0%, 100% { transform: translateY(4rpx) rotate(0.5deg); }
  40%       { transform: translateY(-13rpx) rotate(-1deg); }
  80%       { transform: translateY(6rpx) rotate(0.3deg); }
}
@keyframes floatD {
  0%, 100% { transform: translateY(-8rpx) rotate(-0.9deg); }
  60%       { transform: translateY(9rpx) rotate(0.7deg); }
}
@keyframes floatE {
  0%, 100% { transform: translateY(2rpx) rotate(0.4deg); }
  35%       { transform: translateY(-15rpx) rotate(-0.6deg); }
  72%       { transform: translateY(5rpx) rotate(0.5deg); }
}
@keyframes floatF {
  0%, 100% { transform: translateY(-4rpx) rotate(-0.3deg); }
  58%       { transform: translateY(12rpx) rotate(0.9deg); }
}
.fa { animation: floatA 3.2s ease-in-out -0.5s  infinite; }
.fb { animation: floatB 4.1s ease-in-out -1.9s  infinite; }
.fc { animation: floatC 3.7s ease-in-out -2.4s  infinite; }
.fd { animation: floatD 2.9s ease-in-out -0.8s  infinite; }
.fe { animation: floatE 4.5s ease-in-out -3.2s  infinite; }
.ff { animation: floatF 3.4s ease-in-out -1.3s  infinite; }

/* ── Person avatar (silhouette style) ── */
.av {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}
.av1 { background: linear-gradient(160deg, #A78BFA, #7C3AED); }
.av2 { background: linear-gradient(160deg, #F472B6, #DB2777); }
.av3 { background: linear-gradient(160deg, #FBBF24, #D97706); }
.av4 { background: linear-gradient(160deg, #60A5FA, #2563EB); }
.av5 { background: linear-gradient(160deg, #34D399, #059669); }
.av6 { background: linear-gradient(160deg, #FB923C, #EA580C); }

/* Head circle */
.av-head {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-radius: 13rpx;
  background: rgba(255,255,255,0.92);
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}
/* Body/shoulders arc */
.av-body {
  position: absolute;
  width: 46rpx;
  height: 32rpx;
  border-radius: 23rpx 23rpx 0 0;
  background: rgba(255,255,255,0.75);
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* Bubble text */
.binfo {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}
.bname {
  font-size: 25rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.brole {
  font-size: 21rpx;
  color: #8E84B8;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── CTA: fixed color + flowing gradient border ── */
.cta-outer {
  flex-shrink: 0;
  margin-top: 20rpx;
  padding: 5rpx;
  border-radius: 64rpx;
  background: linear-gradient(90deg,
    #7B6FA8, #5B8EF0, #C464A8,
    #3ABDB5, #FFB347, #C464A8,
    #5B8EF0, #7B6FA8
  );
  background-size: 400% 100%;
  animation: flowBorder 3s linear infinite;
  box-shadow: 0 8rpx 40rpx rgba(123,111,168,0.35);
  z-index: 3;
}
.cta-inner {
  background: #5A4E9C;
  border-radius: 60rpx;
  padding: 28rpx 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cta-inner:active {
  opacity: 0.88;
  transform: scale(0.98);
}
.cta-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 5rpx;
}

@keyframes flowBorder {
  0%   { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

/* ── Bottom auth modal ── */
.auth-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(26, 26, 46, 0.22);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.auth-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 40rpx 58rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -18rpx 60rpx rgba(40, 30, 80, 0.16);
  text-align: center;
}

.auth-pill {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #D8D2EA;
  margin: 0 auto 28rpx;
}

.auth-title {
  font-size: 36rpx;
  line-height: 1.3;
  color: #1A1A2E;
  font-weight: 800;
}

.auth-desc {
  margin: 14rpx auto 28rpx;
  max-width: 560rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #786F98;
}

.auth-primary {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #5A4E9C;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0;
}
.auth-primary::after { border: none; }
.auth-primary[disabled] {
  background: #9A91C3;
  color: rgba(255, 255, 255, 0.9);
}

.auth-exit {
  display: block;
  margin-top: 24rpx;
  font-size: 25rpx;
  color: #8E84B8;
}
