.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 80rpx;
}

.state-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.loading-dot-wrap { display: flex; gap: 12rpx; }
.dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #C4B5FD;
  animation: dotBounce 1.2s ease-in-out infinite;
}
.d1 { animation-delay: 0s; }
.d2 { animation-delay: 0.2s; }
.d3 { animation-delay: 0.4s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.form { padding: 24rpx 32rpx; }

.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid #F4F4F4;
  gap: 20rpx;
}
.field:last-child { border-bottom: none; }
.field-col {
  flex-direction: column;
  align-items: flex-start;
  padding: 24rpx 0;
}

.field-label {
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1A1A1A;
}
.field-input.small { max-width: 80rpx; }

.field-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #1A1A1A;
  margin-top: 16rpx;
  min-height: 320rpx;
  line-height: 1.6;
}

.picker-val {
  font-size: 28rpx;
  color: #7B6FA8;
}

.save-btn {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #7B6FA8;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.save-btn:active { opacity: 0.85; }
.save-btn.disabled { opacity: 0.55; }
