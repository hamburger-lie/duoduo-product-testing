<view class="rp-page">
  <!-- ── Loading ── -->
  <view wx:if="{{phase === 'loading'}}" class="rp-state">
    <view class="rp-state-title">正在打开调研报告</view>
    <view class="rp-state-hint">读取历史档案中的完整报告</view>
  </view>

  <!-- ── Error ── -->
  <view wx:if="{{phase === 'error'}}" class="rp-state rp-state--error">
    <view class="rp-state-title">{{error || '加载失败'}}</view>
    <button class="rp-btn rp-btn--ghost" bindtap="onTapRetry">重试</button>
  </view>

  <!-- ── Ready ── -->
  <view wx:if="{{phase === 'ready'}}" class="rp-ready">

    <!-- ══ 暗色区：hero + 横滑指标 ══ -->
    <view class="rp-dark-zone">
      <view class="rp-hero">
        <view class="rp-hero-orb rp-hero-orb--1"></view>
        <view class="rp-hero-orb rp-hero-orb--2"></view>
        <view class="rp-hero-toprow">
          <view class="rp-hero-grade">{{vm.compositeGrade}}</view>
        </view>
        <view class="rp-hero-name">{{vm.productName}}</view>
        <view class="rp-hero-bar-wrap" wx:if="{{vm.top2BoxPct}}">
          <view class="rp-hero-bar-row">
            <text class="rp-hero-bar-label">Top-2 Box</text>
            <text class="rp-hero-bar-val">{{vm.top2BoxPct}}%</text>
          </view>
          <view class="rp-hero-bar-track">
            <view class="rp-hero-bar-fill" style="width:{{vm.top2BoxPct}}%"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- ══ 亮色区：摘要卡片 ══ -->
    <view class="rp-light-body">

      <!-- 测品结论 -->
      <view class="rp-vc">
        <view class="rp-vc-title">测品结论</view>
        <view class="rp-vc-body">{{vm.conclusion.text}}</view>
      </view>

      <!-- 消费群体评分 -->
      <view class="rp-ps-section" wx:if="{{vm.personaCards.length}}">
        <view class="rp-ps-header">
          <view class="rp-ps-titles">
            <view class="rp-ps-title">消费群体评分</view>
          </view>
          <view class="rp-ps-more">
            <text class="rp-ps-arrow">←</text>
            <text>左右滑动</text>
            <text class="rp-ps-arrow">→</text>
          </view>
        </view>
        <scroll-view class="rp-ps-strip" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
          <view class="rp-ps-track">
            <view class="rp-ps-card" wx:for="{{vm.personaCards}}" wx:key="name">
              <view class="rp-ps-head">
                <view class="rp-ps-copy">
                  <view class="rp-ps-name">{{item.groupTitle}}</view>
                  <view class="rp-ps-hint">{{item.groupHint}}</view>
                </view>
                <view class="rp-ps-tag">{{item.tag}}</view>
              </view>
              <view class="rp-ps-score">{{item.score}}</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 角色洞察 -->
      <view class="rp-voice-section" wx:if="{{vm.personaVoices.length}}">
        <view class="rp-section-title">角色洞察</view>
        <scroll-view class="rp-voice-strip" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
          <view class="rp-voice-track">
            <view class="rp-voice-card rp-voice-card--{{item.tone}}" wx:for="{{vm.personaVoices}}" wx:key="groupTitle">
              <view class="rp-voice-top">
                <view class="rp-voice-person">
                  <view class="rp-voice-name">{{item.groupTitle}}</view>
                </view>
                <view class="rp-voice-score">{{item.score}}</view>
              </view>
              <view class="rp-voice-hint">{{item.groupHint}}</view>
              <view class="rp-voice-quote">“{{item.quote}}”</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 核心亮点 + 风险提醒 -->
      <view class="rp-insight-grid" wx:if="{{vm.opportunities.length || vm.risks.length}}">
        <view class="rp-insight-card">
          <view class="rp-insight-title">核心亮点</view>
          <view class="rp-insight-item" wx:for="{{vm.opportunities}}" wx:for-index="idx" wx:key="title" wx:if="{{idx < 3}}">
            <view class="rp-insight-icon rp-insight-icon--pos">✓</view>
            <text class="rp-insight-text">{{item.concise || item.title}}</text>
          </view>
        </view>
        <view class="rp-insight-card">
          <view class="rp-insight-title">风险提醒</view>
          <view class="rp-insight-item" wx:for="{{vm.risks}}" wx:for-index="idx" wx:key="title" wx:if="{{idx < 3}}">
            <view class="rp-insight-icon rp-insight-icon--neg">△</view>
            <text class="rp-insight-text">{{item.concise || item.title}}</text>
          </view>
        </view>
      </view>

      <!-- 数据详情区 -->
      <!-- ══ 1c. 六维表现雷达图 ══ -->
      <view class="rp-section" wx:if="{{vm.sixDimBreakdown.length}}">
        <view class="rp-section-title">六维表现雷达图</view>
        <view class="rp-radar-canvas-box">
          <canvas canvas-id="rp-radar" id="rp-radar" bindtap="onTapRadarCanvas"
            style="width:280px;height:280px;display:block;margin:0 auto;"></canvas>
          <view class="rp-radar-tap-hint">点击红点查看详细数值</view>
        </view>
      </view>

    <!-- ══ 2. 消费者群体分布 ══ -->
    <view class="rp-section" wx:if="{{vm.heatmapRows.length}}">
      <view class="rp-section-title">消费者群体分布</view>
      <view class="rp-hm-wrap">

        <!-- 列标题 -->
        <view class="rp-hm-header-row">
          <view class="rp-hm-row-label rp-hm-row-label--header"></view>
          <view class="rp-hm-col-header" wx:for="{{vm.heatmapDimHeaders}}" wx:key="*this">{{item}}</view>
        </view>

        <!-- 数据行 -->
        <view class="rp-hm-row" wx:for="{{vm.heatmapRows}}" wx:key="segment">
          <view class="rp-hm-row-label">{{item.segment}}</view>
          <view
            class="rp-hm-cell"
            wx:for="{{item.cells}}"
            wx:for-item="cell"
            wx:key="label"
            style="background:{{cell.bg}}"
          >
            <text class="rp-hm-cell-text">{{cell.score}}</text>
          </view>
        </view>

        <!-- 图例 -->
        <view class="rp-hm-legend">
          <text class="rp-hm-legend-label">1</text>
          <view class="rp-hm-legend-bar"></view>
          <text class="rp-hm-legend-label">5</text>
          <text class="rp-hm-legend-unit">调研均值（1–5）</text>
        </view>

      </view>
    </view>

    <!-- ══ 3. 购买意愿分布 ══ -->
    <view class="rp-section" wx:if="{{vm.stackedBar.length}}">
      <view class="rp-section-title">购买意愿分布</view>
      <view class="rp-stacked-meta">
        <text class="rp-stacked-t2b">高意向购买率 {{vm.top2BoxPct}}%</text>
        <text class="rp-stacked-hint">（评分4~5分占比）</text>
      </view>
      <view class="rp-score-bars">
        <view class="rp-score-bar-row" wx:for="{{vm.stackedBar}}" wx:key="key">
          <view class="rp-score-bar-label">
            <view class="rp-score-bar-dot" style="background:{{item.color}}"></view>
            <text class="rp-score-bar-name">{{item.key}}分·{{item.desc}}</text>
            <text class="rp-score-bar-count">{{item.count}}人</text>
          </view>
          <view class="rp-score-bar-track">
            <view class="rp-score-bar-fill" style="width:{{item.scoreWidth}}%;background:{{item.color}}">
              <text class="rp-score-bar-val">{{item.key}}分</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ══ 4. 核心指标均值 ══ -->
    <view class="rp-section" wx:if="{{vm.dimensionBars.length}}">
      <view class="rp-section-title">核心指标均值</view>
      <view class="rp-section-subtitle">各指标均值 = 该题评分总和 / 有效回答数</view>
      <view class="rp-dim-row" wx:for="{{vm.dimensionBars}}" wx:key="label">
        <view class="rp-dim-label">{{item.label}}</view>
        <view class="rp-dim-track">
          <view class="rp-dim-fill rp-dim-fill--above" style="width:{{item.width}}%"></view>
        </view>
        <view class="rp-dim-value rp-dim-value--above">{{item.value}}</view>
      </view>
    </view>


    <!-- ══ 深度研究报告（可折叠）══ -->
    <view class="rp-deep-panel">
      <view class="rp-deep-toggle" bindtap="onTapDeepToggle">
        <view class="rp-deep-toggle-left">
          <view class="rp-deep-toggle-title">深度研究报告</view>
        </view>
        <view class="rp-deep-chevron {{deepAnalysisExpanded ? 'rp-deep-chevron--open' : ''}}"></view>
      </view>
      <view wx:if="{{deepAnalysisExpanded}}" class="rp-deep-body">
        <view wx:if="{{deepAnalysisLoading}}" class="rp-deep-loading">正在生成深度分析…</view>
        <block wx:elif="{{deepAnalysis}}">
          <view class="rp-deep-section" wx:for="{{deepAnalysis.sections}}" wx:key="title">
            <view class="rp-deep-section-title">{{item.title}}</view>
            <view wx:if="{{item.highlight}}" class="rp-deep-highlight">{{item.highlight}}</view>
            <view class="rp-deep-section-content">{{item.content}}</view>
          </view>
          <!-- 附录：计算口径 -->
          <view class="rp-deep-appendix">
            <view class="rp-deep-appendix-title">附录：计算口径</view>
            <view class="rp-deep-appendix-item" wx:for="{{vm.formulaNotes}}" wx:key="index">{{item}}</view>
            <view class="rp-deep-appendix-source">来源口径：NIST 算术均值、OECD/联合国统计比例与百分数、Qualtrics Top Box 箱体占比。</view>
          </view>
        </block>
        <view wx:else class="rp-deep-loading">深度分析生成失败，请稍后重试</view>
      </view>
    </view>

      <!-- ══ Actions ══ -->
      <view class="rp-actions">
        <button class="rp-btn rp-btn--primary" bindtap="onTapExport">导出 PDF</button>
        <button class="rp-btn rp-btn--ghost" bindtap="onTapFollowUp">继续追问产品</button>
      </view>

      <view class="rp-disclaimer">{{vm.disclaimer}}</view>
    </view><!-- /rp-light-body -->
  </view>
</view>
