}
.rp-signal-item:last-child { border-bottom: none; padding-bottom: 0; }
.rp-signal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #252139;
  line-height: 1.4;
  margin-bottom: 10rpx;
}
.rp-signal-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rp-signal-track {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
