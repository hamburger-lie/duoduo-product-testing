page { background: #0D0820; }

.rp-page {
  padding: 0;
  background: transparent;
}

.rp-ready {
  display: flex;
  flex-direction: column;
}

/* ── 暗色区 ── */
.rp-dark-zone {
  padding: 52rpx 24rpx 60rpx;
  background: #F5F0E8;
  background-size: 200% 200%;
  animation: heroBgShift 7s ease-in-out infinite;
}

/* ── 亮色区 ── */
.rp-light-body {
  background: #F5F3FA;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -24rpx;
  padding: 32rpx 24rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: relative;
  z-index: 2;
}

/* ── State ── */
.rp-state {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.05);
  min-height: 360rpx;
  padding: 60rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  text-align: center;
}
.rp-state--error { border: 2rpx solid #E8E0F3; }
.rp-state-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A2E;
}
.rp-state-hint {
  font-size: 29rpx;
  color: #817B91;
}

/* ══════════════════════════════════════════
   HERO / DASHBOARD
══════════════════════════════════════════ */
@keyframes heroBgShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.rp-hero {
  position: relative;
  overflow: hidden;
}

/* animated orbs */
.rp-hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.rp-hero-orb--1 {
  width: 320rpx;
  height: 320rpx;
  top: -90rpx;
  right: -70rpx;
  background: radial-gradient(circle, rgba(124,92,252,0.42), transparent 70%);
  animation: orbFloat 5.5s ease-in-out infinite;
}
.rp-hero-orb--2 {
  width: 280rpx;
  height: 280rpx;
  bottom: -70rpx;
  left: -50rpx;
  background: radial-gradient(circle, rgba(56,130,245,0.22), transparent 70%);
  animation: orbFloat 7s ease-in-out infinite reverse;
}
@keyframes orbFloat {
  0%, 100% { opacity: 0.5; transform: scale(0.94); }
  50%       { opacity: 1;   transform: scale(1.10); }
}

/* top row */
.rp-hero-toprow {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rp-hero-verdict-chip {
  flex: 1;
  min-width: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124,92,252,0.45);
  background: rgba(124,92,252,0.18);
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.92);
}
.rp-hero-grade {
  flex-shrink: 0;
  font-size: 100rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
  color: #1A1A2E;
}

/* product name */
.rp-hero-name {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1A2E;
  line-height: 1.35;
}

/* consensus bar */
.rp-hero-bar-wrap {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(0,0,0,0.1);
}
.rp-hero-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.rp-hero-bar-label {
  font-size: 26rpx;
  color: #5A5372;
  font-weight: 600;
}
.rp-hero-bar-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #1A1A2E;
}
.rp-hero-bar-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,0.1);
  overflow: hidden;
}
.rp-hero-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #9B8FD4, #7C5CFC);
}

/* ══ Evidence strip ══ */
.rp-ev-strip {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
  margin-top: 24rpx;
}
.rp-ev-strip::-webkit-scrollbar { display: none; }
.rp-ev-chip {
  flex-shrink: 0;
  min-width: 148rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124,92,252,0.12);
  background: #FFFFFF;
  padding: 22rpx 24rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(124,92,252,0.07);
}
.rp-ev-val {
  font-size: 44rpx;
  font-weight: 800;
  color: #120A2E;
  line-height: 1;
  letter-spacing: -1rpx;
}
.rp-ev-label {
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
  font-weight: 500;
}

/* ══════════════════════════════════════════
   CARD SUMMARY SECTIONS
══════════════════════════════════════════ */

/* 测品结论 */
.rp-vc {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.07);
  padding: 28rpx 28rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06);
}
.rp-vc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.02em;
  margin-bottom: 14rpx;
}
.rp-vc-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #0F172A;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.rp-vc-body {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.75;
  color: #1E293B;
  letter-spacing: -0.01em;
}
.rp-vc-hl {
  display: inline;
  background: #F1F0FF;
  color: #3730A3;
  font-weight: 700;
  border-radius: 6rpx;
  padding: 0 6rpx;
}

/* 消费群体评分 */
.rp-ps-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.07);
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06);
}
.rp-ps-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.rp-ps-titles { flex: 1; }
.rp-ps-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.03em;
}
.rp-ps-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #8B5CF6;
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #F3EEFF;
  font-weight: 600;
}
.rp-ps-arrow {
  font-size: 28rpx;
  line-height: 1;
}
.rp-ps-strip {
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  padding-bottom: 4rpx;
}
.rp-ps-strip::-webkit-scrollbar { display: none; }
.rp-ps-track {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  min-width: 100%;
}
.rp-ps-card {
  flex-shrink: 0;
  width: 560rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 1rpx solid #F1F5F9;
  background: #FFFFFF;
  padding: 22rpx 22rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(15,23,42,0.045);
}
.rp-ps-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 14rpx;
}
.rp-ps-copy {
  flex: 1;
  min-width: 0;
}
.rp-ps-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1F1B3D;
  line-height: 1.2;
}
.rp-ps-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #6B647F;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rp-ps-score {
  font-size: 48rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.04em;
  line-height: 1.1;
  text-align: center;
}
.rp-ps-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #F3EEFF;
  font-size: 24rpx;
  font-weight: 700;
  color: #8B5CF6;
  flex-shrink: 0;
}

/* 角色洞察 */
.rp-voice-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 20, 54, 0.04);
}
.rp-voice-strip {
  width: 100%;
  white-space: nowrap;
  margin-top: 20rpx;
}
.rp-voice-strip::-webkit-scrollbar { display: none; }
.rp-voice-track {
  display: inline-flex;
  flex-direction: row;
  gap: 18rpx;
  padding-right: 4rpx;
}
.rp-voice-card {
  flex-shrink: 0;
  width: 520rpx;
  min-height: 258rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #F8F6FF;
  border: 1rpx solid #ECE7FF;
  white-space: normal;
  box-sizing: border-box;
}
.rp-voice-card--green {
  background: #F0FDF7;
  border-color: #C8F7DD;
}
.rp-voice-card--amber {
  background: #FFFBEB;
  border-color: #FDE7A8;
}
.rp-voice-card--blue {
  background: #EFF6FF;
  border-color: #CFE3FF;
}
.rp-voice-card--slate {
  background: #F8FAFC;
  border-color: #E2E8F0;
}
.rp-voice-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}
.rp-voice-person {
  flex: 1;
  min-width: 0;
}
.rp-voice-name {
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #1F1B3D;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rp-voice-score {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #7C3AED;
  font-size: 24rpx;
  font-weight: 800;
}
.rp-voice-quote {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #201B3A;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.rp-voice-hint {
  margin-top: 6rpx;
  margin-left: auto;
  max-width: 360rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #6B647F;
  font-weight: 700;
  text-align: right;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 核心亮点 + 风险提醒 */
.rp-insight-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.rp-insight-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15,23,42,0.07);
  padding: 24rpx 18rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.06);
}
.rp-insight-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: -0.03em;
  margin-bottom: 18rpx;
}
.rp-insight-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.rp-insight-item:last-child { margin-bottom: 0; }
.rp-insight-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
}
.rp-insight-icon--pos {
  color: #10B981;
  border: 2rpx solid #10B981;
}
.rp-insight-icon--neg {
  color: #F43F5E;
  border: 0;
  border-radius: 0;
}
.rp-insight-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.75;
  color: #334155;
  font-weight: 600;
}

/* 下一步动作 */
.rp-action-card {
  background: #F7F5FF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(124,92,252,0.1);
  padding: 28rpx;
}
.rp-action-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.rp-action-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #EDE9FE;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rp-action-icon-sym {
  font-size: 32rpx;
  color: #7C3AED;
  line-height: 1;
}
.rp-action-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.02em;
}
.rp-action-rows { display: flex; flex-direction: column; gap: 0; }
.rp-action-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(124,92,252,0.08);
  font-size: 30rpx;
  line-height: 1.5;
}
.rp-action-row:first-child { padding-top: 0; }
.rp-action-row:last-child { border-bottom: none; padding-bottom: 0; }
.rp-action-key {
  font-weight: 700;
  color: #6B7280;
  min-width: 120rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1.75;
}
.rp-action-val { flex: 1; color: #0F172A; font-size: 30rpx; line-height: 1.75; }
.rp-action-val--accent { color: #0F172A; font-weight: 600; }

/* ── kept for 购买意愿分布 section ── */
.rp-score-bar-track {
  margin: 14rpx auto 0;
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(124, 92, 252, 0.12);
  overflow: hidden;
}
.rp-score-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #A78BFA, #7C5CFC);
  transition: width 0.6s ease;
}

/* Business signals */
.rp-signals {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}
.rp-signal {
  flex: 1;
  background: rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 14rpx;
  padding: 14rpx 10rpx;
  text-align: center;
}
.rp-signal--active {
  background: rgba(124,92,252,0.08);
  border-color: rgba(124,92,252,0.25);
}
.rp-signal-label {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
}
.rp-signal-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #000000;
}
.rp-signal--active .rp-signal-value { color: #7C5CFC; }

/* ── 综合评分看板（游戏战报样式）─────────────────── */
.rp-stat-board {
  margin-top: 32rpx;
}

.rp-stat-board-top {
  position: relative;
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rp-stat-corner {
  position: absolute;
}
.rp-stat-corner--tl { top: 0; left: 0; }
.rp-stat-corner--tr { top: 0; right: 0; text-align: right; align-items: flex-end; }
.rp-stat-corner--bl { bottom: 0; left: 0; }
.rp-stat-corner--br { bottom: 0; right: 0; text-align: right; align-items: flex-end; }

.rp-stat-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.rp-stat-score {
  font-size: 128rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
  background: linear-gradient(135deg, #C4B8E8, #A78BFA, #9B8FD4, #7C5CFC, #A78BFA, #C4B8E8);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: gradeShift 4s ease infinite;
}

@keyframes gradeShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.rp-stat-badge {
  margin-top: 14rpx;
  padding: 6rpx 22rpx;
  background: rgba(124,92,252,0.12);
  border: 1rpx solid rgba(124,92,252,0.35);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #7C5CFC;
  font-weight: 600;
}

.rp-stat-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rp-stat-item--r {
  align-items: flex-end;
}

.rp-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.1;
}

.rp-stat-lbl {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
}

.rp-stat-board-bottom {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.rp-stat-item--b {
  flex: 1;
  align-items: center;
  text-align: center;
}

.rp-stat-item--b .rp-stat-num {
  font-size: 44rpx;
}

.rp-stat-sep {
  width: 1rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.1);
}

/* Verdict reason */
.rp-hero-reason {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.65);
  line-height: 1.65;
}

/* ══════════════════════════════════════════
   SECTION SHELL
══════════════════════════════════════════ */
.rp-section {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 26, 46, 0.04);
  padding: 30rpx 28rpx;
}
.rp-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #19172B;
  margin-bottom: 20rpx;
}
.rp-section-subtitle {
  margin-top: -10rpx;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  color: #5F5870;
  line-height: 1.45;
}

/* ── Summary ── */
.rp-summary-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.rp-summary-item {
  font-size: 30rpx;
  color: #4C485E;
  line-height: 1.65;
  padding-left: 16rpx;
  border-left: 4rpx solid #C4B8E8;
}

/* ── Focus cards ── */
.rp-focus-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.rp-focus {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #FBFAFF;
  border: 1rpx solid #E8E0F3;
}
.rp-focus-label {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F0EDF7;
  color: #6F5B99;
  font-size: 26rpx;
  font-weight: 800;
}
.rp-focus-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #252139;
  line-height: 1.35;
}
.rp-focus-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #625D70;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ══════════════════════════════════════════
   1b. 评分拆解
══════════════════════════════════════════ */
.rp-sbd-table {
  display: flex;
  flex-direction: column;
}
.rp-sbd-header {
  display: flex;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #EDE9F6;
  margin-bottom: 4rpx;
}
.rp-sbd-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F0FA;
}
.rp-sbd-row:last-child { border-bottom: none; }
.rp-sbd-col {
  font-size: 28rpx;
  line-height: 1.4;
}
.rp-sbd-col--dim {
