   6. CLAIM EFFECTIVENESS
══════════════════════════════════════════ */
/* ══ 卖点与顾虑（纵向发散柱状图）══ */
.rp-dv-chart {
  position: relative;
  margin-top: 16rpx;
}

.rp-dv-inner {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.rp-dv-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rp-dv-top {
  height: 180rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.rp-dv-bottom {
  height: 180rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.rp-dv-bar {
  width: 60%;
  border-radius: 4rpx;
  min-height: 6rpx;
}

.rp-dv-bar--pos {
  border-radius: 4rpx 4rpx 0 0;
  background: linear-gradient(180deg, #A78BFA 0%, #7C3AED 100%);
}

.rp-dv-bar--neg {
  border-radius: 0 0 4rpx 4rpx;
  background: linear-gradient(180deg, #E83A5A 0%, #B91C3A 100%);
}

.rp-dv-lbl {
  font-size: 22rpx;
  color: #9B96A8;
  text-align: center;
  line-height: 1.3;
  overflow: hidden;
  word-break: break-all;
  padding: 0 2rpx;
}

.rp-dv-lbl--above {
  height: 48rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6rpx;
}

.rp-dv-lbl--below {
  height: 48rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 6rpx;
}

.rp-dv-lbl--spacer {
  height: 48rpx;
}

.rp-dv-axis {
  position: absolute;
  top: 228rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #D0C8E8;
  pointer-events: none;
}

/* ══ 卖点与顾虑（合并区块）══ */
.rp-signal-group {
  margin-bottom: 24rpx;
}
.rp-signal-group:last-child { margin-bottom: 0; }
.rp-signal-group--neg { margin-top: 8rpx; }
