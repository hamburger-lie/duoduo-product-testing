/* ══════════════════════════════════════════
   11. PRIORITY MATRIX
══════════════════════════════════════════ */
.rp-matrix {
  position: relative;
  background: #FAF9FC;
  border: 1rpx solid #ECE8F3;
  border-radius: 16rpx;
  padding: 20rpx;
}
.rp-matrix-axis-top {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #4C465C;
  font-weight: 700;
}
.rp-matrix-inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.rp-matrix-inner::before,
.rp-matrix-inner::after {
  content: "";
  position: absolute;
  background: rgba(88, 80, 116, 0.12);
  z-index: 1;
}
.rp-matrix-inner::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
}
.rp-matrix-inner::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
}
.rp-matrix-cell {
  position: relative;
  z-index: 2;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 206rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
}
.rp-matrix-cell--tl {
  background: linear-gradient(180deg, #F5F1FB, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #3D2E7C;
}
.rp-matrix-cell--tr {
  background: linear-gradient(180deg, #F0EDF7, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #7C5CFC;
}
.rp-matrix-cell--bl {
  background: linear-gradient(180deg, #F7F7F9, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #A7A4B4;
}
.rp-matrix-cell--br {
  background: linear-gradient(180deg, #F5F2FF, #FFFFFF);
  box-shadow: inset 4rpx 0 0 #7C3AED;
}
.rp-matrix-cell-badge {
  display: inline-block;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}
.rp-matrix-cell-badge--warn    { background: rgba(61,46,124,0.1);   color: #3D2E7C; }
.rp-matrix-cell-badge--good    { background: rgba(124,92,252,0.12); color: #7C5CFC; }
.rp-matrix-cell-badge--neutral { background: rgba(124,92,252,0.1);  color: #4C485E; }
.rp-matrix-cell-badge--purple  { background: rgba(124,58,237,0.1);  color: #5B21B6; }
.rp-matrix-cell-hint {
  font-size: 27rpx;
  color: #5E566D;
  margin-bottom: 16rpx;
  line-height: 1.3;
}
.rp-matrix-item {
  padding: 18rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(226, 222, 236, 0.88);
  margin-bottom: 12rpx;
}
.rp-matrix-item:last-child { margin-bottom: 0; }
.rp-matrix-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}
.rp-matrix-item-title {
  flex: 1;
  font-size: 31rpx;
  font-weight: 800;
  color: #2A263B;
  line-height: 1.42;
}
.rp-matrix-item-pct {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 900;
  color: #241B46;
  line-height: 1.2;
}
.rp-matrix-item-meta {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #4F485C;
  line-height: 1.45;
}
.rp-matrix-empty {
  padding: 42rpx 0 28rpx;
  font-size: 28rpx;
  color: #625B70;
  text-align: center;
}
.rp-matrix-axis-x {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 4rpx;
  font-size: 28rpx;
  color: #4C465C;
  font-weight: 700;
}

/* ══════════════════════════════════════════
   MARKETING ANGLES
══════════════════════════════════════════ */
.rp-angle-card {
  background: #FBFAFF;
  border: 1rpx solid #EAE4F4;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}
.rp-angle-card:last-child { margin-bottom: 0; }
.rp-angle-angle {
  font-size: 30rpx;
  font-weight: 700;
  color: #252139;
  line-height: 1.5;
}
.rp-angle-meta {
  margin-top: 8rpx;
}
.rp-angle-seg {
  font-size: 27rpx;
  color: #7C3AED;
}
.rp-angle-risk {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #5A4E9C;
  background: rgba(124,92,252,0.1);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  line-height: 1.5;
}

/* ── Audience/channels ── */
.rp-audience-block {
  margin-bottom: 20rpx;
}
.rp-audience-block:last-child { margin-bottom: 0; }
.rp-audience-label {
  font-size: 27rpx;
  font-weight: 700;
  color: #6B667A;
  margin-bottom: 10rpx;
}
.rp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rp-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.rp-tag--pos { background: rgba(124,92,252,0.12); color: #7C5CFC; }
.rp-tag--neg { background: rgba(61,46,124,0.1);  color: #3D2E7C; }
.rp-channel {
  font-size: 29rpx;
  color: #5C586A;
  line-height: 1.6;
  padding: 10rpx 0;
  border-top: 1rpx solid #F0EEF4;
}
.rp-channel:first-child { border-top: none; }

/* ── Attributed quotes ── */
.rp-attr-quote {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  border-left: 4rpx solid #C4B8E8;
  background: #F8F7FA;
  margin-bottom: 16rpx;
}
.rp-attr-quote:last-child { margin-bottom: 0; }
.rp-attr-quote--pos { border-left-color: #A78BFA; background: #F5F1FB; }
.rp-attr-quote--neg { border-left-color: #C4B8E8; background: #F0EDF7; }
.rp-attr-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #7B6FA8;
  margin-bottom: 8rpx;
}
.rp-attr-quote--pos .rp-attr-name { color: #7C5CFC; }
.rp-attr-quote--neg .rp-attr-name { color: #3D2E7C; }
.rp-attr-text {
  font-size: 30rpx;
  color: #403B54;
  line-height: 1.65;
}

/* ── Plain quotes (fallback) ── */
.rp-quote {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #F8F7FA;
  color: #403B54;
  font-size: 30rpx;
  line-height: 1.65;
  margin-bottom: 14rpx;
}
.rp-quote:last-child { margin-bottom: 0; }

/* ── Steps ── */
.rp-step {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.rp-step:last-child { margin-bottom: 0; }
.rp-step-num {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #241B46;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.rp-step-text {
  flex: 1;
  font-size: 30rpx;
  color: #4C485E;
  line-height: 1.55;
}

/* ── Actions ── */
.rp-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rp-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  padding: 0;
}
.rp-btn::after { border: none; }
.rp-btn--primary {
  background: #241B46;
  color: #fff;
}
.rp-btn--ghost {
  background: #fff;
  color: #241B46;
  border: 2rpx solid #DED9EA;
}

/* ── Disclaimer ── */
.rp-disclaimer {
  text-align: center;
  color: #9B96A8;
  font-size: 26rpx;
  line-height: 1.6;
  padding: 4rpx 20rpx;
}

.rp-formula-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0EEF4;
  color: #19172B;
  font-size: 30rpx;
  line-height: 1.65;
  font-weight: 600;
}

.rp-formula-item:last-of-type {
  border-bottom: none;
}

.rp-formula-source {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #F6F3FB;
  color: #4D4560;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ══════════════════════════════════════════
   深度研究报告（可折叠）
══════════════════════════════════════════ */
.rp-deep-panel {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 26, 46, 0.04);
  overflow: hidden;
}

.rp-deep-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  gap: 16rpx;
}

.rp-deep-toggle-left {
  flex: 1;
  min-width: 0;
}

.rp-deep-toggle-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #19172B;
  line-height: 1.35;
}

.rp-deep-toggle-sub {
  margin-top: 6rpx;
  font-size: 27rpx;
  color: #7C3AED;
  line-height: 1.4;
}

.rp-deep-chevron {
  width: 18rpx;
  height: 18rpx;
  border-right: 3rpx solid #9B96A8;
  border-bottom: 3rpx solid #9B96A8;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  flex-shrink: 0;
  margin-top: -4rpx;
}

.rp-deep-chevron--open {
  transform: rotate(-135deg);
  margin-top: 4rpx;
}

.rp-deep-body {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid #F0EEF4;
}

.rp-deep-loading {
  padding: 40rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #9B96A8;
  line-height: 1.6;
}

.rp-deep-section {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0EEF4;
}

.rp-deep-section:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rp-deep-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #19172B;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.rp-deep-highlight {
  background: #F3EEFF;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
  font-size: 29rpx;
  color: #5B2EB0;
  font-weight: 600;
  line-height: 1.8;
  white-space: pre-line;
}

.rp-deep-section-content {
  font-size: 30rpx;
  color: #19172B;
  line-height: 1.75;
}

.rp-deep-appendix {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #F0EEF4;
}

.rp-deep-appendix-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #19172B;
  margin-bottom: 8rpx;
}

.rp-deep-appendix-sub {
  font-size: 30rpx;
  color: #19172B;
  font-weight: 700;
  line-height: 1.75;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.rp-deep-appendix-sub--neg {
  color: #3D2E7C;
}

.rp-deep-appendix-item {
  font-size: 30rpx;
  color: #19172B;
  line-height: 1.75;
  padding: 6rpx 0;
}

.rp-deep-appendix-source {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #19172B;
  line-height: 1.75;
}
