  margin-bottom: 16rpx;
}
.rp-signal-group-header--pos {
  background: rgba(124,92,252,0.08);
  color: #7C5CFC;
}
.rp-signal-group-header--neg {
  background: rgba(61,46,124,0.08);
  color: #3D2E7C;
}
.rp-signal-item {
  padding: 12rpx 0;
