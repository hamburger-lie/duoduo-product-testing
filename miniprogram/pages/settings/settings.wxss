.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx 0 80rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 32rpx 32rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.menu-last { border-bottom: none; }
.menu-item:active { background: #F9F9F9; }

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}
.menu-value {
  font-size: 26rpx;
  color: #999999;
}
.menu-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  font-weight: 300;
}

.logout-wrap {
  padding: 0 32rpx;
  margin-top: 16rpx;
}
.logout-btn {
  height: 96rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #EF4444;
  font-weight: 500;
}
.logout-btn:active { opacity: 0.75; }
