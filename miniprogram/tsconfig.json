{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "noImplicitThis": true,
    "removeComments": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["miniprogram-api-typings"]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
